{% extends 'base.html.twig' %}

{% block title %}Ubytování | Tesák-Čerňava – Horský penzion Hostýnské vrchy{% endblock %}
{% block description %}Útulné pokoje a apartmány pro 51 osob v horském penzionu Tesák-Čerňava. Rodinné pokoje, dvoulůžkové pokoje, velký apartmán. Hostýnské vrchy, 690 m n. m.{% endblock %}
{% block og_title %}Ubytování | Tesák-Čerňava{% endblock %}
{% block og_description %}Útulné pokoje a apartmány v přírodní rezervaci Tesák. 51 lůžek, rodinná atmosféra, krb, zahrada.{% endblock %}

{% block body %}

    <header class="page-header">
      <img class="page-header__bg"
        src="{{ asset('images/rooms/family-double/img_3199-6.webp') }}"
        alt="Exteriér penzionu Tesák-Čerňava – horský penzion v Hostýnských vrších" loading="eager">
      <div class="container">
        <div class="page-header__content">
          <span class="page-header__eyebrow">Ubytování</span>
          <h1 class="page-header__title">U nás jako doma</h1>
          <p class="page-header__lead">Útulné pokoje a apartmány pro rodiny, skupiny i páry. 51 lůžek v přírodní rezervaci Tesák, 690 m n. m.</p>
        </div>
      </div>
    </header>

    <section class="section" aria-labelledby="about-heading">
      <div class="container">
        <div class="grid-2" style="align-items:center;gap:var(--space-16)">
          <div>
            <span class="eyebrow">O penzionu</span>
            <h2 id="about-heading" style="font-size:var(--text-xl);margin:var(--space-3) 0 var(--space-6)">Chata na kopci Tesák</h2>
            <p style="color:var(--color-text-secondary);margin-bottom:var(--space-4)">
              Chata Tesák-Čerňava se nachází na kopci Tesák nad městem Chvalčov nedaleko Bystřice pod Hostýnem. Tesák je přírodní rezervace v lokalitě Rajnochovice v okrese Kroměříž – ptačí oblast a evropsky významná lokalita.
            </p>
            <p style="color:var(--color-text-secondary);margin-bottom:var(--space-4)">
              Tento retro rekreační objekt kompletně zrekonstruovaný v roce 2012 na Vás dýchne klidem s možností zasnít se při pohledu do velkého krbu z pohodlné sedačky.
            </p>
            <p style="color:var(--color-text-secondary);margin-bottom:var(--space-6)">
              Chata stojí v nadmořské výšce 690 m n. m. a obklopuje ji ze dvou stran bukový les. V zahradě najdete dětské hřiště, trampolínu, posezení u ohniště a voliéru se zvířátky.
            </p>
            <ul style="display:flex;flex-direction:column;gap:var(--space-2)">
              <li style="display:flex;align-items:center;gap:var(--space-2);font-size:var(--text-sm);color:var(--color-text-secondary)">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                51 lůžek + přistýlky (celková kapacita)
              </li>
              <li style="display:flex;align-items:center;gap:var(--space-2);font-size:var(--text-sm);color:var(--color-text-secondary)">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Koupelny se sprchovým koutem a WC (u dvoulůžkových pokojů sdílené)
              </li>
              <li style="display:flex;align-items:center;gap:var(--space-2);font-size:var(--text-sm);color:var(--color-text-secondary)">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Kuchyňky dostupné pro hosty na každém patře
              </li>
              <li style="display:flex;align-items:center;gap:var(--space-2);font-size:var(--text-sm);color:var(--color-text-secondary)">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Malí psi do 4 kg vítáni (190 Kč/noc)
              </li>
              <li style="display:flex;align-items:center;gap:var(--space-2);font-size:var(--text-sm);color:var(--color-text-secondary)">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Check-in od 14:00, check-out do 10:00
              </li>
            </ul>
          </div>
          <div style="display:flex;flex-direction:column;gap:var(--space-4)">
            <img
              src="{{ asset('images/facilities/img20240126193956.webp') }}"
              alt="Útulná společenská místnost s krbem v penzionu Tesák-Čerňava"
              style="width:100%;height:280px;object-fit:cover;border-radius:var(--radius-xl)"
              loading="lazy">
            <img
              src="{{ asset('images/views/dji_0097.webp') }}"
              alt="Letecký pohled na penzion Tesák-Čerňava v Hostýnských vrších"
              style="width:100%;height:220px;object-fit:cover;border-radius:var(--radius-xl)"
              loading="lazy">
          </div>
        </div>
      </div>
    </section>

    <section class="section section--muted" aria-labelledby="rooms-heading">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Pokoje a apartmány</span>
          <h2 id="rooms-heading">Vyberte si pokoj</h2>
          <p>Vyberte si pokoj dle velikosti skupiny. Většina pokojů má vlastní koupelnu se sprchovým koutem a WC, dvoulůžkové pokoje mají koupelnu sdílenou.</p>
        </div>

        <div class="grid-3">
          {% for room in rooms %}
          <article class="room-card">
            <div class="room-card__gallery">
              <button class="room-card__main" data-gallery="{{ room.slug }}" type="button" aria-label="{{ room.name }} – zobrazit fotogalerii">
                {% set main = room.mainImage %}
                <img src="{{ main ? main.thumbnail : asset('images/rooms/' ~ room.slug ~ '/placeholder.webp') }}" alt="{{ main and main.alt ? main.alt : room.name }}" loading="lazy">
                <span class="room-card__photo-badge">{% set n = room.images|length %}{{ n }} {{ n == 1 ? 'fotka' : (n >= 2 and n <= 4 ? 'fotky' : 'fotek') }}</span>
              </button>
              <div class="room-card__thumbs">
                {% for image in room.images|slice(1, 3) %}
                  <button class="room-card__thumb" data-gallery="{{ room.slug }}" type="button" aria-label="{{ room.name }} – fotka {{ loop.index + 1 }}">
                    <img src="{{ image.thumbnail }}" alt="{{ image.alt ?? room.name }}" loading="lazy">
                    {% if loop.last and room.images|length > 4 %}<span class="room-card__thumb-more" aria-hidden="true">+{{ room.images|length - 4 }}</span>{% endif %}
                  </button>
                {% endfor %}
                {% for image in room.images|slice(4) %}
                  <button class="room-card__thumb room-card__thumb--extra" data-gallery="{{ room.slug }}" type="button" tabindex="-1" aria-hidden="true">
                    <img src="{{ image.thumbnail }}" alt="{{ image.alt ?? room.name }}" loading="lazy">
                  </button>
                {% endfor %}
              </div>
            </div>
            <div class="room-card__body">
              <h3 class="room-card__name">{{ room.name }}</h3>
              <ul class="room-card__features">
                {% for feature in room.features %}
                <li>
                  <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  {{ feature }}
                </li>
                {% endfor %}
              </ul>
              <div class="room-card__footer">
                {% if room.priceLabel %}
                <div class="room-card__price">
                  <span class="room-card__price-amount">{{ room.priceLabel }}</span>
                  <span class="room-card__price-unit">{{ room.priceUnit }}</span>
                </div>
                {% endif %}
                <a href="#rezervace" data-book-room="{{ room.id }}" class="btn btn--primary btn--sm">Rezervovat</a>
              </div>
            </div>
          </article>
          {% endfor %}
        </div>

        <p style="text-align:center;margin-top:var(--space-8)">
          <a href="{{ path('app_pricing') }}" class="btn btn--outline">Zobrazit kompletní ceník</a>
        </p>
      </div>
    </section>

    {% set booking_rooms = rooms|map(r => {
      id: r.id,
      name: r.name,
      capacity: r.capacity,
      price: r.price,
      priceFrom: r.priceFrom,
      priceUnit: r.priceUnit,
      priceSingleNight: r.priceSingleNight,
      perPerson: 'osob' in (r.priceUnit ?? ''),
    }) %}
    <section class="section booking" id="rezervace" aria-labelledby="booking-heading"
      data-rooms="{{ booking_rooms|json_encode }}"
      data-availability-url="{{ path('api_availability') }}"
      data-submit-url="{{ path('api_reservations_create') }}"
      data-max-nights="{{ constant('App\\DTO\\BookingRequest::MAX_NIGHTS') }}"
      data-today="{{ 'today'|date('Y-m-d') }}">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Rezervace</span>
          <h2 id="booking-heading">Volné termíny</h2>
          <p>V řádku pokoje klikněte na den příjezdu a pak na den odjezdu, nebo termín přetáhněte myší. Den, kdy jedni hosté odjíždějí, je zároveň volný pro příjezd dalších.</p>
        </div>

        <noscript>
          <p class="alert alert--info">Pro výběr termínu je potřeba zapnutý JavaScript. Poptávku nám můžete poslat také přes <a href="{{ path('app_contact') }}">kontaktní formulář</a>.</p>
        </noscript>

        <div class="booking__toolbar">
          <div class="booking__nav">
            <button type="button" class="btn btn--outline btn--sm" data-booking-prev aria-label="Předchozí dny">‹</button>
            <button type="button" class="btn btn--outline btn--sm" data-booking-today>Dnes</button>
            <button type="button" class="btn btn--outline btn--sm" data-booking-next aria-label="Další dny">›</button>
            <span class="booking__range" data-booking-range aria-live="polite"></span>
          </div>
          <ul class="booking__legend">
            <li><span class="booking__swatch booking__swatch--free"></span>Volno</li>
            <li><span class="booking__swatch booking__swatch--busy"></span>Obsazeno</li>
            <li><span class="booking__swatch booking__swatch--half"></span>Příjezd / odjezd jiných hostů</li>
            <li><span class="booking__swatch booking__swatch--sel"></span>Váš termín</li>
          </ul>
        </div>

        <div class="booking__scroll" data-booking-scroll>
          <div class="booking__grid" data-booking-grid></div>
        </div>
        <p class="booking__hint" data-booking-hint aria-live="polite"></p>

        <div class="booking__panel" data-booking-panel hidden>
          <form class="form booking__form" data-booking-form novalidate>
            <div class="booking__summary-head">
              <dl class="booking__summary" data-booking-summary></dl>
              <button type="button" class="btn btn--outline btn--sm" data-booking-reset>Změnit termín</button>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="booking-name">Jméno a příjmení <span class="req" aria-hidden="true">*</span></label>
                <input class="form-input" type="text" id="booking-name" name="name" required autocomplete="name" maxlength="180">
                <span class="form-error" data-error-for="name" hidden></span>
              </div>
              <div class="form-group">
                <label class="form-label" for="booking-guests">Počet osob <span class="req" aria-hidden="true">*</span></label>
                <input class="form-input" type="number" id="booking-guests" name="guests" required min="1" inputmode="numeric">
                <span class="form-error" data-error-for="guests" hidden></span>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="booking-email">E-mail <span class="req" aria-hidden="true">*</span></label>
                <input class="form-input" type="email" id="booking-email" name="email" required autocomplete="email" inputmode="email" maxlength="180">
                <span class="form-error" data-error-for="email" hidden></span>
              </div>
              <div class="form-group">
                <label class="form-label" for="booking-phone">Telefon <span class="req" aria-hidden="true">*</span></label>
                <input class="form-input" type="tel" id="booking-phone" name="phone" required autocomplete="tel" inputmode="tel" maxlength="40">
                <span class="form-error" data-error-for="phone" hidden></span>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="booking-note">Poznámka</label>
              <textarea class="form-textarea" id="booking-note" name="note" maxlength="1000" placeholder="Např. pozdní příjezd, přistýlka, pes, strava…"></textarea>
              <span class="form-error" data-error-for="note" hidden></span>
            </div>
            <div class="booking__hp" aria-hidden="true">
              <label for="booking-website">Web</label>
              <input type="text" id="booking-website" name="website" tabindex="-1" autocomplete="off">
            </div>
            <div class="form-group">
              <label class="form-checkbox">
                <input type="checkbox" name="consent" required>
                <span>Souhlasím se <a href="{{ path('app_privacy') }}" target="_blank">zpracováním osobních údajů</a> za účelem vyřízení rezervace.</span>
              </label>
              <span class="form-error" data-error-for="consent" hidden></span>
            </div>

            <p class="alert alert--error" data-booking-error hidden></p>
            <div class="booking__submit">
              <button type="submit" class="btn btn--primary">Odeslat poptávku</button>
              <span>Rezervace je závazná až po našem potvrzení e-mailem.</span>
            </div>
          </form>

          <div class="alert alert--success" data-booking-success tabindex="-1" hidden>
            <strong>Děkujeme, poptávku jsme přijali.</strong><br>
            Termín pro Vás předběžně držíme. Potvrzení pošleme co nejdříve e-mailem.
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="facilities-heading">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Vybavení a služby</span>
          <h2 id="facilities-heading">Naše kuchyně i Vaše</h2>
          <p>Domácí strava z čerstvých potravin, ne z náhražkových průmyslových produktů. Nebo si vařte sami – kuchyňky jsou dostupné na každém patře.</p>
        </div>

        <div class="grid-3" style="gap:var(--space-4)">
          <figure style="margin:0">
            <img
              src="{{ asset('images/facilities/p1055117-hdr.webp') }}"
              alt="Kuchyně penzionu Tesák-Čerňava vybavená pro vaření skupinových pobytů"
              style="width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:var(--radius-xl)"
              loading="lazy">
            <figcaption style="text-align:center;font-size:var(--text-sm);color:var(--color-text-muted);margin-top:var(--space-2)">Plně vybavená kuchyně</figcaption>
          </figure>
          <figure style="margin:0">
            <img
              src="{{ asset('images/facilities/p1055164-hdr.webp') }}"
              alt="Jídelna penzionu Tesák-Čerňava pro skupinové stravování"
              style="width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:var(--radius-xl)"
              loading="lazy">
            <figcaption style="text-align:center;font-size:var(--text-sm);color:var(--color-text-muted);margin-top:var(--space-2)">Prostorná jídelna</figcaption>
          </figure>
          <figure style="margin:0">
            <img
              src="{{ asset('images/facilities/p1055135-hdr.webp') }}"
              alt="Útulná společenská místnost s posezením u krbu v penzionu Tesák-Čerňava"
              style="width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:var(--radius-xl)"
              loading="lazy">
            <figcaption style="text-align:center;font-size:var(--text-sm);color:var(--color-text-muted);margin-top:var(--space-2)">Jídelna s posezením u krbu</figcaption>
          </figure>
        </div>

        <div style="margin-top:var(--space-12);display:flex;gap:var(--space-8);align-items:center;flex-wrap:wrap">
          <img
            src="{{ asset('images/facilities/img_3300-5.webp') }}"
            alt="Kuchyňka na chodbě penzionu – dostupná pro hosty na každém patře"
            style="width:min(100%,420px);border-radius:var(--radius-xl);flex-shrink:0"
            loading="lazy">
          <div>
            <h3 style="font-size:var(--text-lg);margin-bottom:var(--space-4)">Kuchyňky na každé chodbě</h3>
            <p style="color:var(--color-text-secondary);margin-bottom:var(--space-4)">
              Na každém patře je kuchyňka, kde si můžete uvařit sami.
            </p>
            <ul style="display:flex;flex-direction:column;gap:var(--space-2)">
              <li style="display:flex;align-items:center;gap:var(--space-2);font-size:var(--text-sm);color:var(--color-text-secondary)">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Vařič a mikrovlnná trouba
              </li>
              <li style="display:flex;align-items:center;gap:var(--space-2);font-size:var(--text-sm);color:var(--color-text-secondary)">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Lednice a základní nádobí
              </li>
              <li style="display:flex;align-items:center;gap:var(--space-2);font-size:var(--text-sm);color:var(--color-text-secondary)">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Dostupné na každém patře zdarma
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--muted" aria-labelledby="garden-heading">
      <div class="container">
        <div class="grid-2" style="align-items:center;gap:var(--space-12)">
          <div>
            <span class="eyebrow">Zahrada a areál</span>
            <h2 id="garden-heading" style="font-size:var(--text-xl);margin:var(--space-3) 0 var(--space-6)">Zahrada</h2>
            <p style="color:var(--color-text-secondary);margin-bottom:var(--space-4)">
              Z jedné strany chaty je parkoviště, z druhé oplocená zahrada s dětským hřištěm, trampolínou, posezením u ohniště a voliérou. Hned za plotem začíná bukový les.
            </p>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-4);margin-top:var(--space-6)">
              <div style="background:white;border-radius:var(--radius-lg);padding:var(--space-4);box-shadow:var(--shadow-sm)">
                <p style="font-size:1.5rem;margin-bottom:var(--space-2)">🛝</p>
                <p style="font-weight:600;font-size:var(--text-sm)">Dětské hřiště</p>
                <p style="font-size:var(--text-sm);color:var(--color-text-muted)">Hřiště a trampolína</p>
              </div>
              <div style="background:white;border-radius:var(--radius-lg);padding:var(--space-4);box-shadow:var(--shadow-sm)">
                <p style="font-size:1.5rem;margin-bottom:var(--space-2)">🔥</p>
                <p style="font-weight:600;font-size:var(--text-sm)">Ohniště</p>
                <p style="font-size:var(--text-sm);color:var(--color-text-muted)">Posezení u táboráku</p>
              </div>
              <div style="background:white;border-radius:var(--radius-lg);padding:var(--space-4);box-shadow:var(--shadow-sm)">
                <p style="font-size:1.5rem;margin-bottom:var(--space-2)">🐰</p>
                <p style="font-weight:600;font-size:var(--text-sm)">Voliéra</p>
                <p style="font-size:var(--text-sm);color:var(--color-text-muted)">Andulky, králíček a morčata</p>
              </div>
              <div style="background:white;border-radius:var(--radius-lg);padding:var(--space-4);box-shadow:var(--shadow-sm)">
                <p style="font-size:1.5rem;margin-bottom:var(--space-2)">🌲</p>
                <p style="font-weight:600;font-size:var(--text-sm)">Bukový les</p>
                <p style="font-size:var(--text-sm);color:var(--color-text-muted)">Přímo za plotem zahrady</p>
              </div>
            </div>
          </div>
          <img
            src="{{ asset('images/facilities/p1055139-hdr.webp') }}"
            alt="Společenská místnost penzionu Tesák-Čerňava s posezením"
            style="width:100%;border-radius:var(--radius-xl);max-height:480px;object-fit:cover"
            loading="lazy">
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="practical-heading">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Praktické informace</span>
          <h2 id="practical-heading">Než přijedete</h2>
        </div>
        <div class="grid-3" style="gap:var(--space-6)">
          <div style="background:var(--color-surface-card);border:1px solid var(--color-border-default);border-radius:var(--radius-xl);padding:var(--space-6)">
            <h3 style="font-size:var(--text-base);margin-bottom:var(--space-4)">Příjezd a odjezd</h3>
            <ul style="display:flex;flex-direction:column;gap:var(--space-2)">
              <li style="display:flex;gap:var(--space-2);font-size:var(--text-sm);color:var(--color-text-secondary)"><span style="color:var(--color-primary-600);font-weight:600;flex-shrink:0">Check-in:</span> od 14:00 (nebo dle dohody)</li>
              <li style="display:flex;gap:var(--space-2);font-size:var(--text-sm);color:var(--color-text-secondary)"><span style="color:var(--color-primary-600);font-weight:600;flex-shrink:0">Check-out:</span> do 10:00</li>
              <li style="display:flex;gap:var(--space-2);font-size:var(--text-sm);color:var(--color-text-secondary)"><span style="color:var(--color-primary-600);font-weight:600;flex-shrink:0">Parkování:</span> zdarma na místě</li>
            </ul>
          </div>
          <div style="background:var(--color-surface-card);border:1px solid var(--color-border-default);border-radius:var(--radius-xl);padding:var(--space-6)">
