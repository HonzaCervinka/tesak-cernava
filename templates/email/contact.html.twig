<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="UTF-8">
<style>
  body { font-family: sans-serif; color: #1a1f1a; font-size: 15px; line-height: 1.6; }
  table { width: 100%; border-collapse: collapse; margin-top: 1.5rem; }
  th { text-align: left; width: 40%; color: #666; font-weight: normal; padding: .4rem 0; border-bottom: 1px solid #eee; }
  td { padding: .4rem 0; border-bottom: 1px solid #eee; }
</style>
</head>
<body>
<h2>Nová poptávka ubytování</h2>
<table>
  <tr><th>Jméno</th><td>{{ data.name }}</td></tr>
  <tr><th>E-mail</th><td><a href="mailto:{{ data.email }}">{{ data.email }}</a></td></tr>
  <tr><th>Telefon</th><td>{{ data.phone }}</td></tr>
  <tr><th>Typ pobytu</th><td>{{ data.stayType }}</td></tr>
  <tr><th>Příjezd</th><td>{{ data.dateFrom }}</td></tr>
  <tr><th>Odjezd</th><td>{{ data.dateTo }}</td></tr>
  {% if data.adults is not null %}<tr><th>Dospělí</th><td>{{ data.adults }}</td></tr>{% endif %}
  {% if data.children is not null %}<tr><th>Děti</th><td>{{ data.children }}</td></tr>{% endif %}
  {% if data.message %}<tr><th>Zpráva</th><td style="white-space:pre-wrap">{{ data.message }}</td></tr>{% endif %}
</table>
</body>
</html>
