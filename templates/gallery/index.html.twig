{% extends 'base.html.twig' %}

{% block title %}Galerie | Tesák-Čerňava – Penzion v Hostýnských vrších{% endblock %}
{% block description %}Fotogalerie penzionu Tesák-Čerňava: pokoje, jídelna, zahrada, příroda Hostýnských vrchů. Podívejte se, jak to u nás vypadá.{% endblock %}
{% block og_title %}Galerie | Tesák-Čerňava{% endblock %}
{% block og_description %}Prohlédněte si fotogalerii penzionu Tesák-Čerňava – prostory, přírodu a okolí.{% endblock %}

{% block head_extra %}
<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  @media (min-width: 640px) {
    .gallery-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 1024px) {
    .gallery-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .gallery-item {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    cursor: pointer;
    background: var(--color-surface-muted);
  }
  .gallery-item img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
    transition: transform 300ms ease;
  }
  .gallery-item:hover img,
  .gallery-item:focus img {
    transform: scale(1.05);
  }
  .gallery-item:focus {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
  }
  .gallery-item__caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-2) var(--space-3);
    background: linear-gradient(transparent, rgba(25,18,16,.7));
    color: #fff;
    font-size: var(--text-sm);
    opacity: 0;
    transition: opacity var(--transition-base);
  }
  .gallery-item:hover .gallery-item__caption,
  .gallery-item:focus .gallery-item__caption {
    opacity: 1;
  }
  .gallery-item--wide {
    grid-column: span 2;
  }
  .gallery-item--wide img {
    aspect-ratio: 2/1;
  }
</style>
{% endblock %}

