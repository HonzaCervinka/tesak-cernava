{% extends 'base.html.twig' %}

{% block title %}Školy v přírodě a skupiny | Tesák-Čerňava{% endblock %}
{% block description %}Ideální místo pro školy v přírodě, tábory a firemní akce. Plná penze, kapacita 51 lůžek, dětský program. Hostýnské vrchy, Chvalčov.{% endblock %}
{% block og_title %}Školy v přírodě a skupiny | Tesák-Čerňava{% endblock %}
{% block og_description %}Ideální místo pro školy v přírodě, tábory a firemní akce. Plná penze, kapacita 51 lůžek, dětský program.{% endblock %}

{% block body %}

    <header class="page-header">
      <img class="page-header__bg"
        src="{{ asset('images/views/img20220525204625---kopie.webp') }}"
        alt="" loading="eager" aria-hidden="true">
      <div class="container">
        <div class="page-header__content">
          <span class="page-header__eyebrow">Pro skupiny</span>
          <h1 class="page-header__title">Školy v přírodě a skupinové pobyty</h1>
          <p class="page-header__lead">Kapacita 51 lůžek, plná penze pro děti, zkušený personál. Ideální pro školy, tábory, soustředění i firemní akce.</p>
        </div>
      </div>
    </header>

    <section class="section" aria-labelledby="why-heading">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Proč Tesák-Čerňava</span>
          <h2 id="why-heading">Vše, co skupina potřebuje na jednom místě</h2>
        </div>
        <div class="feature-grid">
          <div class="feature-item">
            <div class="feature-item__icon" aria-hidden="true">
              <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div>
              <h3 class="feature-item__title">51 lůžek + přistýlky</h3>
              <p class="feature-item__desc">Možnost ubytovat celou třídu nebo skupinu najednou. Různé typy pokojů pro různé potřeby.</p>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-item__icon" aria-hidden="true">
              <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
            </div>
            <div>
              <h3 class="feature-item__title">Plná penze</h3>
              <p class="feature-item__desc">3× denně jídlo + 2× svačina + pitný režim po celý den. Domácí strava z čerstvých surovin.</p>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-item__icon" aria-hidden="true">
              <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <h3 class="feature-item__title">Bezpečné prostředí</h3>
              <p class="feature-item__desc">Oplocená zahrada s dětským hřištěm a trampolínou. Příroda přímo u penzionu.</p>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-item__icon" aria-hidden="true">
              <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 17l4-8 4 4 4-6 4 10"/><path d="M21 21H3"/></svg>
            </div>
            <div>
              <h3 class="feature-item__title">Turistické trasy</h3>
              <p class="feature-item__desc">Křižovatka značených tras. Rozhledny, bukové lesy, příroda chráněné oblasti přímo za plotem.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--muted" aria-labelledby="package-heading">
      <div class="container">
        <div class="grid-2" style="align-items:start;gap:var(--space-16)">
          <div>
            <span class="eyebrow">Skupinový balíček</span>
            <h2 id="package-heading" style="font-size:var(--text-xl);margin-top:var(--space-3);margin-bottom:var(--space-6)">Škola v přírodě — vše v ceně</h2>

            <div style="background:var(--color-surface-card);border-radius:var(--radius-xl);padding:var(--space-8);border:1px solid var(--color-border-default);margin-bottom:var(--space-6)">
              <div style="display:flex;align-items:baseline;gap:var(--space-3);margin-bottom:var(--space-2)">
                <span style="font-family:var(--font-heading);font-size:var(--text-3xl);font-weight:700;color:var(--color-primary-600)">748 Kč</span>
                <span style="color:var(--color-text-muted)">/ dítě / den</span>
              </div>
              <p style="font-size:var(--text-sm);color:var(--color-success-text);font-weight:500;margin-bottom:var(--space-6)">Pondělí–pátek: 2 990 Kč / dítě za celý týden</p>

              <ul style="display:flex;flex-direction:column;gap:var(--space-3)">
                <li class="room-card__feature" style="gap:var(--space-3)">
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>3× denně teplé jídlo</span>
                </li>
                <li class="room-card__feature" style="gap:var(--space-3)">
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>2× denně svačina</span>
                </li>
                <li class="room-card__feature" style="gap:var(--space-3)">
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Pitný režim po celý den</span>
                </li>
                <li class="room-card__feature" style="gap:var(--space-3)">
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Ubytování v pokojích s koupelnou</span>
                </li>
                <li class="room-card__feature" style="gap:var(--space-3)">
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>Na 10 dětí 1 dospělý zdarma (při plném obsazení)</span>
                </li>
              </ul>
            </div>

            <div class="alert alert--info">
              <strong>Postýlka pro děti do 2 let zdarma.</strong> Přezůvky s sebou, prosíme.
            </div>
          </div>

          <div>
            <h3 style="font-size:var(--text-lg);margin-bottom:var(--space-5)">Vhodné pro</h3>
            <div style="display:flex;flex-direction:column;gap:var(--space-3);margin-bottom:var(--space-8)">
              <div style="padding:var(--space-4) var(--space-5);background:var(--color-surface-card);border-radius:var(--radius-lg);border:1px solid var(--color-border-default);display:flex;align-items:center;gap:var(--space-4)">
                <div style="width:40px;height:40px;background:var(--color-surface-primary-light);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;color:var(--color-primary-600);flex-shrink:0">
                  <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                </div>
                <div>
                  <p style="font-weight:600">Školy v přírodě</p>
                  <p style="font-size:var(--text-sm);color:var(--color-text-muted)">1.–9. třída, výukové i rekreační</p>
                </div>
              </div>
              <div style="padding:var(--space-4) var(--space-5);background:var(--color-surface-card);border-radius:var(--radius-lg);border:1px solid var(--color-border-default);display:flex;align-items:center;gap:var(--space-4)">
                <div style="width:40px;height:40px;background:var(--color-surface-primary-light);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;color:var(--color-primary-600);flex-shrink:0">
                  <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
                </div>
                <div>
                  <p style="font-weight:600">Tábory a soustředění</p>
                  <p style="font-size:var(--text-sm);color:var(--color-text-muted)">Sportovní, pěvecká, lyžařská soustředění</p>
                </div>
              </div>
              <div style="padding:var(--space-4) var(--space-5);background:var(--color-surface-card);border-radius:var(--radius-lg);border:1px solid var(--color-border-default);display:flex;align-items:center;gap:var(--space-4)">
                <div style="width:40px;height:40px;background:var(--color-surface-primary-light);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;color:var(--color-primary-600);flex-shrink:0">
                  <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                </div>
                <div>
                  <p style="font-weight:600">Firemní akce a teambuilding</p>
                  <p style="font-size:var(--text-sm);color:var(--color-text-muted)">Skupinová sezení, oslava, neformální setkání</p>
                </div>
              </div>
              <div style="padding:var(--space-4) var(--space-5);background:var(--color-surface-card);border-radius:var(--radius-lg);border:1px solid var(--color-border-default);display:flex;align-items:center;gap:var(--space-4)">
                <div style="width:40px;height:40px;background:var(--color-surface-primary-light);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;color:var(--color-primary-600);flex-shrink:0">
                  <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                </div>
                <div>
                  <p style="font-weight:600">Rodinné oslavy a setkání</p>
                  <p style="font-size:var(--text-sm);color:var(--color-text-muted)">Narozeniny, výročí, rodinné sjezdy</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="testimonials-school-heading">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Říkají o nás</span>
          <h2 id="testimonials-school-heading">Co říkají organizátoři</h2>
        </div>
        <div class="testimonials-grid">
          <blockquote class="testimonial" style="border-left-color:var(--color-primary-500)">
            <p class="testimonial__quote">„Organizace bezchybná. Děti byly nadšené z voliéry i z výletů. Personál vstřícný, jídlo chutné. Škola v přírodě jak má být."</p>
            <footer class="testimonial__author">
              <div class="testimonial__avatar" aria-hidden="true">J</div>
              <div>
                <p class="testimonial__name">Jana N.</p>
                <p class="testimonial__meta">Třídní učitelka · ZŠ Zlín</p>
              </div>
            </footer>
          </blockquote>
          <blockquote class="testimonial" style="border-left-color:var(--color-primary-500)">
            <p class="testimonial__quote">„Poprvé jsem sem jela s obavami, jestli kapacita vyjde. Vyjde i s rezervou. Příjezd, ubytování, stravování — vše proběhlo bez jediného problému."</p>
            <footer class="testimonial__author">
              <div class="testimonial__avatar" aria-hidden="true">M</div>
              <div>
                <p class="testimonial__name">Markéta H.</p>
                <p class="testimonial__meta">Zástupkyně ředitele · ZŠ Kroměříž</p>
              </div>
            </footer>
          </blockquote>
        </div>
      </div>
    </section>

    <section class="section section--muted" aria-labelledby="faq-heading">
      <div class="container" style="max-width:800px">
        <div class="section-header">
          <span class="eyebrow">Časté dotazy</span>
          <h2 id="faq-heading">Odpovědi, které hledáte</h2>
        </div>
        <div style="display:flex;flex-direction:column;gap:var(--space-4)">
          <details style="background:var(--color-surface-card);border-radius:var(--radius-lg);border:1px solid var(--color-border-default);padding:var(--space-5)">
            <summary style="cursor:pointer;font-weight:600;list-style:none;display:flex;justify-content:space-between;align-items:center">
              Jaká je maximální kapacita pro skupiny?
              <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <p style="margin-top:var(--space-4);color:var(--color-text-secondary)">Penzion má kapacitu 51 lůžek + přistýlky. Při plném obsazení vychází jeden dospělý vedoucí na 10 dětí zdarma.</p>
          </details>
          <details style="background:var(--color-surface-card);border-radius:var(--radius-lg);border:1px solid var(--color-border-default);padding:var(--space-5)">
            <summary style="cursor:pointer;font-weight:600;list-style:none;display:flex;justify-content:space-between;align-items:center">
              Zvládnete stravování pro alergiky?
              <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <p style="margin-top:var(--space-4);color:var(--color-text-secondary)">Ano, prosím uveďte alergie a diety při poptávce. Vaříme z čerstvých surovin, takže úpravy jsou možné.</p>
          </details>
          <details style="background:var(--color-surface-card);border-radius:var(--radius-lg);border:1px solid var(--color-border-default);padding:var(--space-5)">
            <summary style="cursor:pointer;font-weight:600;list-style:none;display:flex;justify-content:space-between;align-items:center">
              V jakém předstihu je třeba rezervovat?
              <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <p style="margin-top:var(--space-4);color:var(--color-text-secondary)">Doporučujeme 3–6 měsíců předem, zejména pro jarní termíny škol v přírodě. Termíny se rychle obsazují.</p>
          </details>
          <details style="background:var(--color-surface-card);border-radius:var(--radius-lg);border:1px solid var(--color-border-default);padding:var(--space-5)">
            <summary style="cursor:pointer;font-weight:600;list-style:none;display:flex;justify-content:space-between;align-items:center">
              Vystavíte fakturu pro školu?
              <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <p style="margin-top:var(--space-4);color:var(--color-text-secondary)">Ano. IČO: 44348649, Pavel Dobiáš, Chvalčov 253. Fakturaci upřesníme při rezervaci.</p>
          </details>
          <details style="background:var(--color-surface-card);border-radius:var(--radius-lg);border:1px solid var(--color-border-default);padding:var(--space-5)">
            <summary style="cursor:pointer;font-weight:600;list-style:none;display:flex;justify-content:space-between;align-items:center">
              Je penzion dostupný autobusem nebo autem?
              <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <p style="margin-top:var(--space-4);color:var(--color-text-secondary)">Penzion je snadno dostupný autem. Parkování přímo u budovy. Bližší navigaci poskytujeme po rezervaci.</p>
          </details>
        </div>
      </div>
    </section>

    <section class="section" id="poptavka" aria-labelledby="form-heading">
      <div class="container" style="max-width:720px">
        <div class="section-header">
          <span class="eyebrow">Nezávazná poptávka</span>
          <h2 id="form-heading">Poptat skupinový pobyt</h2>
          <p>Odpovíme do 24 hodin s dostupností a cenou.</p>
        </div>

        <div id="form-success" hidden tabindex="-1">
          <div class="alert alert--success" style="font-size:var(--text-md);padding:var(--space-6)">
            <strong>Poptávka odeslána!</strong> Odpovíme Vám do 24 hodin na uvedený e-mail nebo telefon. Děkujeme za zájem.
          </div>
        </div>

        <div id="form-container">
          <form class="form" id="inquiry-form" novalidate>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="name">Jméno a příjmení <span class="req" aria-hidden="true">*</span></label>
                <input class="form-input" type="text" id="name" name="name" required autocomplete="name" aria-required="true" aria-describedby="name-err">
                <span class="form-error" id="name-err" hidden>
                  <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                  Vyplňte prosím jméno.
                </span>
              </div>
              <div class="form-group">
                <label class="form-label" for="org">Škola / organizace</label>
                <input class="form-input" type="text" id="org" name="org" placeholder="ZŠ Příklad, s.r.o.…" autocomplete="organization">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="email">E-mail <span class="req" aria-hidden="true">*</span></label>
                <input class="form-input" type="email" id="email" name="email" required autocomplete="email" inputmode="email" aria-required="true" aria-describedby="email-err">
                <span class="form-error" id="email-err" hidden>
                  <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                  Vyplňte prosím e-mail.
                </span>
              </div>
              <div class="form-group">
                <label class="form-label" for="phone">Telefon <span class="req" aria-hidden="true">*</span></label>
                <input class="form-input" type="tel" id="phone" name="phone" required autocomplete="tel" inputmode="tel" aria-required="true" aria-describedby="phone-err">
                <span class="form-error" id="phone-err" hidden>
                  <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                  Vyplňte prosím telefon.
                </span>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="stay-type">Typ pobytu <span class="req" aria-hidden="true">*</span></label>
              <select class="form-select" id="stay-type" name="stay_type" required aria-required="true" aria-describedby="type-err">
                <option value="">— Vyberte typ pobytu —</option>
                <option value="skola">Škola v přírodě</option>
                <option value="tabor">Tábor nebo soustředění</option>
                <option value="firma">Firemní akce / teambuilding</option>
                <option value="oslava">Rodinná oslava nebo setkání</option>
                <option value="jine">Jiné</option>
              </select>
              <span class="form-error" id="type-err" hidden>
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                Vyberte prosím typ pobytu.
              </span>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="date_from">Datum příjezdu <span class="req" aria-hidden="true">*</span></label>
                <input class="form-input" type="date" id="date_from" name="date_from" required aria-required="true" aria-describedby="datefrom-err">
                <span class="form-error" id="datefrom-err" hidden>Vyplňte datum příjezdu.</span>
              </div>
              <div class="form-group">
                <label class="form-label" for="date_to">Datum odjezdu <span class="req" aria-hidden="true">*</span></label>
                <input class="form-input" type="date" id="date_to" name="date_to" required aria-required="true" aria-describedby="dateto-err">
                <span class="form-error" id="dateto-err" hidden>Vyplňte datum odjezdu.</span>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="adults">Počet dospělých</label>
                <input class="form-input" type="number" id="adults" name="adults" min="1" max="60" placeholder="2">
              </div>
              <div class="form-group">
                <label class="form-label" for="children">Počet dětí</label>
                <input class="form-input" type="number" id="children" name="children" min="0" max="60" placeholder="0">
              </div>
            </div>
            <fieldset class="form-fieldset">
              <legend class="form-legend">Stravování</legend>
              <label class="form-checkbox">
                <input type="checkbox" name="meal_breakfast"> Snídaně
              </label>
              <label class="form-checkbox">
                <input type="checkbox" name="meal_half"> Polopenze
              </label>
              <label class="form-checkbox">
                <input type="checkbox" name="meal_full"> Plná penze (doporučeno pro skupiny)
              </label>
            </fieldset>
            <div class="form-group">
              <label class="form-label" for="message">Zpráva nebo dotaz</label>
              <textarea class="form-textarea" id="message" name="message" maxlength="1000" placeholder="Program, alergie, speciální požadavky…"></textarea>
              <div style="display:flex;justify-content:flex-end"><span class="form-counter" id="msg-counter">0 / 1000</span></div>
            </div>
            <div class="form-group">
              <label class="form-checkbox">
                <input type="checkbox" name="gdpr" required aria-required="true" aria-describedby="gdpr-err">
                <span>Souhlasím se zpracováním osobních údajů za účelem vyřízení poptávky. <span class="req" aria-hidden="true">*</span></span>
              </label>
              <span class="form-error" id="gdpr-err" hidden>Pro odeslání je nutný souhlas.</span>
            </div>
            <button type="submit" class="btn btn--primary btn--full">Odeslat poptávku</button>
          </form>
        </div>
      </div>
    </section>

{% endblock %}
