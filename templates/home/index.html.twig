<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{font-size:16px;scroll-behavior:smooth}

:root{
  --bg:#0B0B0A;
  --bg2:#141413;
  --bg3:#1C1C1A;
  --text:#F0EBE0;
  --muted:rgba(240,235,224,0.42);
  --accent:#DFFF00;
  --border:rgba(240,235,224,0.08);
  --borderm:rgba(240,235,224,0.16);
  --ff:'Syne',sans-serif;
  --mono:'DM Mono',monospace;
  --max:1280px;
  --pad:clamp(1.25rem,4vw,3rem);
}

body{background:var(--bg);color:var(--text);font-family:var(--ff);line-height:1.65;overflow-x:hidden;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
ul{list-style:none}
button{cursor:pointer;font-family:var(--ff);border:none;background:none;color:inherit}

.wrap{max-width:var(--max);margin:0 auto;padding:0 var(--pad)}
.accent{color:var(--accent)}

.label{font-family:var(--mono);font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}

.tag{display:inline-flex;align-items:center;gap:.5rem;font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin-bottom:1.5rem}
.tag::before{content:'';display:block;width:1.5rem;height:1px;background:var(--accent)}

.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.85rem 1.75rem;font-family:var(--ff);font-weight:700;font-size:.9rem;letter-spacing:.01em;transition:all .2s ease;border:1.5px solid transparent;border-radius:2px;cursor:pointer;white-space:nowrap}
.btn--accent{background:var(--accent);color:var(--bg);border-color:var(--accent)}
.btn--accent:hover{background:transparent;color:var(--accent)}
.btn--outline{background:transparent;color:var(--text);border-color:var(--borderm)}
.btn--outline:hover{border-color:var(--text)}
.btn--lg{padding:1.1rem 2.25rem;font-size:1rem}

.reveal{opacity:0;transform:translateY(24px);transition:opacity .65s cubic-bezier(.16,1,.3,1),transform .65s cubic-bezier(.16,1,.3,1)}
.reveal.in{opacity:1;transform:translateY(0)}
.reveal.d1{transition-delay:.1s}
.reveal.d2{transition-delay:.2s}
.reveal.d3{transition-delay:.3s}

/* ── NAV ── */
.nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:1.25rem 0;transition:background .3s,padding .3s}
.nav.scrolled{background:rgba(11,11,10,.93);backdrop-filter:blur(12px);padding:.75rem 0;border-bottom:1px solid var(--border)}
.nav__inner{display:flex;align-items:center;gap:2rem}
.nav__logo{font-weight:800;font-size:1.35rem;letter-spacing:-.02em;margin-right:auto}
.nav__links{display:flex;align-items:center;gap:2rem}
.nav__links a{font-family:var(--mono);font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);transition:color .2s}
.nav__links a:hover{color:var(--text)}
.nav__toggle{display:none;flex-direction:column;gap:5px;padding:.5rem}
.nav__toggle span{display:block;width:24px;height:1.5px;background:var(--text);transition:all .3s}
.nav__mobile{display:none;flex-direction:column;padding:1.5rem var(--pad);background:var(--bg2);border-top:1px solid var(--border)}
.nav__mobile a{padding:.75rem 0;font-weight:600;font-size:1.1rem;border-bottom:1px solid var(--border)}
.nav__mobile .btn{margin-top:1rem;width:100%;justify-content:center}

@media(max-width:768px){
  .nav__links,.nav__cta{display:none}
  .nav__toggle{display:flex}
  .nav__mobile.open{display:flex}
}

/* ── HERO ── */
.hero{min-height:100vh;display:flex;flex-direction:column;padding-top:6rem;position:relative;overflow:hidden;
  background-image:repeating-linear-gradient(0deg,transparent,transparent 79px,var(--border) 80px)}
.hero__inner{flex:1;display:grid;grid-template-columns:1fr 1.05fr;gap:0;align-items:stretch;min-height:calc(100vh - 6rem)}

/* Photo column */
.hero__photo{position:relative;overflow:hidden;border-right:1px solid var(--border)}
.hero__photo img{width:100%;height:100%;object-fit:cover;object-position:top center;display:block;filter:grayscale(15%)}
.hero__pholder{width:100%;height:100%;min-height:520px;background:var(--bg2);display:flex;flex-direction:column;justify-content:flex-end;padding:2rem;position:relative;border-right:1px solid var(--border)}
.hero__pholder::before{content:'';position:absolute;inset:0;border:1.5px dashed rgba(223,255,0,.2);margin:1rem;pointer-events:none}
.hero__pholder-label{font-family:var(--mono);font-size:.6rem;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:1rem;display:flex;align-items:center;gap:.5rem}
.hero__pholder-label::before{content:'';width:1rem;height:1px;background:var(--accent)}
.hero__pholder-prompt{font-family:var(--mono);font-size:.68rem;line-height:1.6;color:rgba(240,235,224,.35);max-width:42ch}
.hero__pholder-corner{position:absolute;top:1.75rem;right:1.75rem;font-family:var(--mono);font-size:.6rem;color:rgba(240,235,224,.2);letter-spacing:.08em}

/* Text column */
.hero__text{display:flex;flex-direction:column;justify-content:center;padding:clamp(2.5rem,5vw,5rem) clamp(2rem,4vw,4rem);gap:2rem}
.hero__name{font-family:var(--mono);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.hero__h1{font-weight:800;font-size:clamp(2.8rem,6vw,6.5rem);line-height:.92;letter-spacing:-.04em;text-transform:uppercase}
.hero__intro{font-size:clamp(.95rem,1.5vw,1.1rem);color:var(--muted);max-width:38ch;line-height:1.6;border-left:2px solid var(--accent);padding-left:1rem}
.hero__cta-group{display:flex;flex-direction:column;gap:1rem}
.hero__checks{display:flex;flex-direction:column;gap:.4rem}
.hero__checks li{font-family:var(--mono);font-size:.75rem;color:var(--muted)}

.hero__niches{border-top:1px solid var(--border);padding:1.5rem 0}
.niche-strip{display:flex;align-items:center;gap:clamp(1.5rem,3vw,3.5rem);flex-wrap:wrap;margin-top:.85rem}
.niche-strip span{font-family:var(--mono);font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(240,235,224,.2);white-space:nowrap}

@media(max-width:900px){
  .hero__inner{grid-template-columns:1fr;min-height:auto}
  .hero__photo{min-height:55vw;border-right:none;border-bottom:1px solid var(--border)}
  .hero__pholder{min-height:55vw}
  .hero__text{padding:2.5rem var(--pad)}
}

/* ── ABOUT ── */
.about__grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(3rem,6vw,6rem);align-items:center}
.about__h2{font-weight:800;font-size:clamp(2.25rem,5vw,4.5rem);letter-spacing:-.04em;line-height:.95;text-transform:uppercase;margin-bottom:1.75rem}
.about__p{color:var(--muted);font-size:.95rem;line-height:1.7;max-width:42ch;margin-bottom:1rem}
.about__facts{display:flex;flex-direction:column;gap:.6rem;margin-top:1.75rem;padding-top:1.75rem;border-top:1px solid var(--border)}
.about__facts li{font-family:var(--mono);font-size:.78rem;color:var(--muted);display:flex;align-items:center;gap:.6rem}
.about__facts li .accent{font-weight:700;font-size:1rem}
.about__photos{display:grid;grid-template-rows:1.6fr 1fr;gap:1rem;height:clamp(480px,55vw,680px)}
.about__photo{overflow:hidden;border-radius:2px;position:relative}
.about__photo img{width:100%;height:100%;object-fit:cover;filter:grayscale(10%);transition:transform .6s ease}
.about__photo:hover img{transform:scale(1.03)}

/* Shared placeholder styles */
.pholder{width:100%;height:100%;background:var(--bg2);display:flex;flex-direction:column;justify-content:flex-end;padding:1.5rem;position:relative}
.pholder::before{content:'';position:absolute;inset:0;border:1.5px dashed rgba(223,255,0,.18);margin:.75rem;pointer-events:none}
.pholder__tag{font-family:var(--mono);font-size:.58rem;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:.75rem;display:block}
.pholder__prompt{font-family:var(--mono);font-size:.63rem;line-height:1.55;color:rgba(240,235,224,.3)}

@media(max-width:900px){
  .about__grid{grid-template-columns:1fr}
  .about__photos{height:auto;grid-template-rows:auto;grid-template-columns:1fr 1fr}
  .about__photo{min-height:240px}
}
@media(max-width:560px){
  .about__photos{grid-template-columns:1fr}
}

/* ── SECTION COMMON ── */
.section{padding:clamp(5rem,10vw,9rem) 0}
.section__hd{display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;margin-bottom:clamp(3rem,6vw,5rem);padding-bottom:2rem;border-bottom:1px solid var(--border)}
.section__h2{font-weight:800;font-size:clamp(2.25rem,5.5vw,5rem);letter-spacing:-.04em;line-height:.95;text-transform:uppercase}

@media(max-width:768px){.section__hd{flex-direction:column;align-items:flex-start}}

/* ── SERVICES ── */
.services__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--border);border:1px solid var(--border)}
.svc{background:var(--bg);padding:clamp(2rem,4vw,3.5rem);display:flex;flex-direction:column;gap:1.5rem;transition:background .3s}
.svc:hover{background:var(--bg3)}
.svc__num{font-family:var(--mono);font-size:.65rem;color:var(--accent);letter-spacing:.1em}
.svc__title{font-weight:800;font-size:clamp(1.5rem,2.5vw,2.25rem);letter-spacing:-.02em;line-height:1.1}
.svc__desc{color:var(--muted);font-size:.88rem;line-height:1.6;flex:1}
.svc__link{font-family:var(--mono);font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);display:flex;align-items:center;gap:.4rem;transition:gap .2s}
.svc:hover .svc__link{gap:.8rem}

@media(max-width:640px){.services__grid{grid-template-columns:1fr}}

/* ── PRICING ── */
.pricing__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}
.pcard{padding:clamp(2rem,3vw,2.75rem);border:1px solid var(--border);border-radius:2px;display:flex;flex-direction:column;gap:2rem;position:relative;transition:border-color .3s}
.pcard:hover{border-color:var(--borderm)}
.pcard--feat{background:var(--bg2);border-color:var(--accent)}
.pcard--feat:hover{border-color:var(--accent)}
.pcard__badge{position:absolute;top:-1px;left:50%;transform:translateX(-50%);background:var(--accent);color:var(--bg);font-family:var(--mono);font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;padding:.22rem .75rem;font-weight:500;border-radius:0 0 2px 2px;white-space:nowrap}
.pcard__tier{font-family:var(--mono);font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted)}
.pcard__price{font-weight:800;font-size:clamp(2rem,3.5vw,2.75rem);letter-spacing:-.04em;line-height:1}
.pcard__price-suffix{font-size:.85rem;font-weight:400;color:var(--muted);letter-spacing:0;margin-left:.1em}
.pcard__for{font-size:.82rem;color:var(--muted);margin-top:.35rem}
.pcard__features{display:flex;flex-direction:column;gap:.65rem;flex:1}
.pcard__features li{font-size:.83rem;display:flex;align-items:flex-start;gap:.6rem;line-height:1.4}
.pcard__features li::before{content:'—';font-family:var(--mono);color:var(--accent);flex-shrink:0}

@media(max-width:900px){.pricing__grid{grid-template-columns:1fr;max-width:480px}}

/* ── DEMO USP ── */
.demo{background:var(--accent);color:var(--bg);padding:clamp(5rem,10vw,9rem) 0;position:relative;overflow:hidden}
.demo__inner{position:relative;z-index:1}
.demo__h2{font-weight:800;font-size:clamp(2.5rem,7vw,7rem);letter-spacing:-.04em;line-height:.95;text-transform:uppercase;max-width:16ch}
.demo__sub{font-size:clamp(1rem,1.5vw,1.2rem);margin-top:2rem;max-width:45ch;opacity:.65}
.demo__cta{margin-top:3rem;display:inline-flex;align-items:center;gap:.6rem;background:var(--bg);color:var(--accent);padding:1rem 2.25rem;font-weight:700;font-size:1rem;border-radius:2px;transition:opacity .2s}
.demo__cta:hover{opacity:.85}
.demo__bgtext{position:absolute;right:-.04em;top:50%;transform:translateY(-50%);font-weight:800;font-size:28vw;line-height:1;color:rgba(0,0,0,.055);pointer-events:none;user-select:none}

/* ── PROCESS ── */
.process__steps{display:grid;grid-template-columns:repeat(4,1fr);position:relative}
.process__steps::before{content:'';position:absolute;top:1.4rem;left:12%;right:12%;height:1px;background:var(--borderm)}
.pstep{padding:0 1.5rem;position:relative;z-index:1}
.pstep:first-child{padding-left:0}
.pstep:last-child{padding-right:0}
.pstep__dot{width:3rem;height:3rem;border:1.5px solid var(--borderm);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:.7rem;color:var(--muted);background:var(--bg);margin-bottom:1.5rem;transition:all .3s}
.pstep:hover .pstep__dot{border-color:var(--accent);color:var(--accent)}
.pstep__title{font-weight:800;font-size:1.1rem;letter-spacing:-.01em;margin-bottom:.4rem}
.pstep__desc{font-size:.83rem;color:var(--muted);line-height:1.5}

@media(max-width:768px){
  .process__steps{grid-template-columns:repeat(2,1fr);gap:2.5rem}
  .process__steps::before{display:none}
  .pstep{padding:0}
}

/* ── GUARANTEES ── */
.guar__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border)}
.guar__card{background:var(--bg);padding:clamp(2rem,3vw,2.75rem);display:flex;flex-direction:column;gap:1.5rem;transition:background .3s}
.guar__card:hover{background:var(--bg3)}
.guar__num{font-family:var(--mono);font-size:.65rem;color:var(--accent);letter-spacing:.1em}
.guar__title{font-weight:800;font-size:clamp(1.1rem,1.8vw,1.5rem);letter-spacing:-.02em;line-height:1.1;text-transform:uppercase}
.guar__desc{font-size:.83rem;color:var(--muted);line-height:1.6}
@media(max-width:768px){.guar__grid{grid-template-columns:1fr}}

/* ── FAQ ── */
.faq__list{display:flex;flex-direction:column}
details.faqitem{border-bottom:1px solid var(--border)}
details.faqitem:first-child{border-top:1px solid var(--border)}
summary.faqitem__q{display:flex;align-items:center;justify-content:space-between;padding:1.5rem 0;font-weight:700;font-size:clamp(.92rem,1.4vw,1.05rem);cursor:pointer;list-style:none;gap:1rem;transition:color .2s}
summary.faqitem__q::-webkit-details-marker{display:none}
summary.faqitem__q:hover{color:var(--accent)}
.faqitem__ico{flex-shrink:0;width:1.5rem;height:1.5rem;border:1px solid var(--borderm);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:.85rem;color:var(--muted);transition:all .3s}
details[open] .faqitem__ico{background:var(--accent);border-color:var(--accent);color:var(--bg);transform:rotate(45deg)}
.faqitem__a{padding:0 0 1.5rem;color:var(--muted);font-size:.88rem;line-height:1.7;max-width:65ch}

/* ── FORM ── */
.formsec{background:var(--bg2);padding:clamp(5rem,10vw,9rem) 0}
.formwrap{max-width:720px;margin:0 auto}
.form__steplbl{display:flex;justify-content:space-between;margin-bottom:.65rem}
.form__prog{height:2px;background:var(--border);border-radius:2px;margin-bottom:3rem;overflow:hidden}
.form__progbar{height:100%;background:var(--accent);border-radius:2px;transition:width .4s cubic-bezier(.16,1,.3,1);width:25%}
.form__step{display:none}
.form__step.active{display:block;animation:fadeUp .4s cubic-bezier(.16,1,.3,1) both}
@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
.form__stitle{font-weight:800;font-size:clamp(1.5rem,3vw,2.25rem);letter-spacing:-.03em;margin-bottom:.4rem}
.form__ssub{color:var(--muted);font-size:.88rem;margin-bottom:2rem}
.rcards{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}
.rcard{position:relative}
.rcard input[type=radio]{position:absolute;opacity:0;width:0;height:0}
.rcard label{display:flex;flex-direction:column;gap:.35rem;padding:1.25rem 1.5rem;border:1.5px solid var(--border);border-radius:2px;cursor:pointer;transition:all .2s}
.rcard input:checked+label{border-color:var(--accent);background:rgba(223,255,0,.06)}
.rcard label:hover{border-color:var(--borderm)}
.rcard__title{font-weight:700;font-size:.93rem}
.rcard__desc{font-size:.78rem;color:var(--muted)}
.ffield{margin-bottom:1.25rem}
.ffield label{display:block;font-family:var(--mono);font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:.5rem}
.ffield input,.ffield select,.ffield textarea{width:100%;background:var(--bg);border:1.5px solid var(--border);color:var(--text);padding:.85rem 1rem;font-family:var(--ff);font-size:1rem;border-radius:2px;transition:border-color .2s;outline:none;-webkit-appearance:none;appearance:none}
.ffield input:focus,.ffield select:focus,.ffield textarea:focus{border-color:var(--accent)}
.ffield select option{background:var(--bg2)}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.fchk{display:flex;align-items:center;gap:.75rem;cursor:pointer;font-size:.88rem;margin-bottom:1rem}
.fchk input{display:none}
.fchk__box{width:1.25rem;height:1.25rem;border:1.5px solid var(--borderm);border-radius:2px;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .2s}
.fchk input:checked~.fchk__box{background:var(--accent);border-color:var(--accent)}
.fchk input:checked~.fchk__box::after{content:'✓';font-size:.68rem;color:var(--bg);font-weight:700}
.form__nav{display:flex;align-items:center;justify-content:space-between;margin-top:2.5rem;gap:1rem}
.form__back{font-family:var(--mono);font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);cursor:pointer;transition:color .2s;padding:.5rem 0}
.form__back:hover{color:var(--text)}
.form__success{display:none;text-align:center;padding:3rem 0}
.form__success.show{display:block}
.form__success-ico{font-size:3rem;margin-bottom:1rem}
.form__success h3{font-weight:800;font-size:2rem;letter-spacing:-.03em;margin-bottom:.75rem}
.form__success p{color:var(--muted);font-size:.9rem}

@media(max-width:480px){
  .rcards{grid-template-columns:1fr}
  .frow{grid-template-columns:1fr}
}

/* ── FOOTER ── */
.footer{border-top:1px solid var(--border);padding:4rem 0 2.5rem}
.footer__top{display:grid;grid-template-columns:2fr 1fr 1fr;gap:4rem;padding-bottom:3rem;border-bottom:1px solid var(--border);margin-bottom:2rem}
.footer__logo{font-weight:800;font-size:1.5rem;letter-spacing:-.03em;margin-bottom:.75rem}
.footer__tagline{font-size:.83rem;color:var(--muted);max-width:30ch;line-height:1.6}
.footer__coltitle{font-family:var(--mono);font-size:.63rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);margin-bottom:1.25rem}
.footer__links{display:flex;flex-direction:column;gap:.6rem}
.footer__links a{font-size:.88rem;color:rgba(240,235,224,.6);transition:color .2s}
.footer__links a:hover{color:var(--text)}
.footer__bottom{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.footer__copy{font-family:var(--mono);font-size:.65rem;color:var(--muted);letter-spacing:.05em}

@media(max-width:768px){.footer__top{grid-template-columns:1fr;gap:2rem}}

/* ── STICKY MOBILE CTA ── */
.sticky{display:none;position:fixed;bottom:0;left:0;right:0;z-index:50;padding:.75rem var(--pad);background:rgba(11,11,10,.95);backdrop-filter:blur(12px);border-top:1px solid var(--border)}
.sticky .btn{width:100%;justify-content:center}
@media(max-width:768px){.sticky{display:block};body{padding-bottom:5rem}}
</style>
{% endblock %}

