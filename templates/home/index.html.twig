{% extends 'base.html.twig' %}

{% block title %}Tesák-Čerňava – Penzion v Hostýnských vrších{% endblock %}
{% block description %}Horský penzion v přírodní rezervaci Tesák, 690 m n. m. Školy v přírodě, rodinné pobyty, wellness a masáže. Hostýnské vrchy, Chvalčov.{% endblock %}
{% block og_title %}Tesák-Čerňava – Penzion v Hostýnských vrších{% endblock %}
{% block og_description %}Horský penzion v přírodní rezervaci Tesák. Školy v přírodě, rodinné pobyty, wellness a masáže.{% endblock %}

{% block head_extra %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  "name": "Penzion Tesák-Čerňava",
  "description": "Horský penzion v přírodní rezervaci Tesák v Hostýnských vrších.",
  "url": "https://tesak-cernava.cz",
  "telephone": "+420775727306",
  "email": "tesakcernava@seznam.cz",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Chvalčov 253",
    "postalCode": "768 72",
    "addressLocality": "Chvalčov",
    "addressCountry": "CZ"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 49.3670216, "longitude": 17.775705 },
  "vatID": "CZ44348649"
}
</script>
{% endblock %}

{% block body %}

    <section class="hero" aria-label="Uvítací sekce">
      <video class="hero__bg" autoplay muted loop playsinline preload="none" aria-hidden="true">
        <source src="{{ asset('video/hero.mp4') }}" type="video/mp4">
      </video>
      <img class="hero__bg hero__bg--fallback"
        src="{{ asset('images/views/dji_0097.webp') }}"
        alt="Panorama Hostýnských vrchů s bukovými lesy"
        loading="eager" width="1400" height="800" aria-hidden="true">
      <div class="hero__overlay" aria-hidden="true"></div>
      <div class="container">
        <div class="hero__content">
          <span class="eyebrow eyebrow--light">Hostýnské vrchy · 690 m n. m.</span>
          <h1 class="hero__title">U nás jako doma, uprostřed přírody</h1>
          <p class="hero__lead">Horský penzion v přírodní rezervaci Tesák. Jezdí k nám školy v přírodě, rodiny s dětmi, tábory, sportovní kluby i firmy.</p>
          <div class="btn-group">
            <a href="{{ path('app_accommodation') }}#rezervace" class="btn btn--primary">Rezervovat pobyt</a>
            <a href="{{ path('app_accommodation') }}" class="btn btn--outline-white">Zjistit více</a>
          </div>
        </div>
      </div>
      <div class="hero__scroll" aria-hidden="true">
        <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
      </div>
    </section>

    <section class="section" aria-labelledby="segments-heading">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Pro koho jsme</span>
          <h2 id="segments-heading">Školy, rodiny, firmy i turisté</h2>
        </div>
        <div class="segments">
          <a href="{{ path('app_groups') }}" class="segment-card">
            <div class="segment-card__icon" aria-hidden="true">
              <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3 class="segment-card__title">Školy v přírodě</h3>
            <p class="segment-card__desc">Plná penze, ubytování až pro 51 dětí, dětské hřiště a voliéra.</p>
            <span class="segment-card__arrow">Více informací →</span>
          </a>
          <a href="{{ path('app_accommodation') }}" class="segment-card">
            <div class="segment-card__icon" aria-hidden="true">
              <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h3 class="segment-card__title">Rodiny s dětmi</h3>
            <p class="segment-card__desc">Zahrada s trampolínou a voliéra s andulkami, králíčkem a morčaty. Občas přijde i kocour Garfield.</p>
            <span class="segment-card__arrow">Ubytování →</span>
          </a>
          <a href="{{ path('app_contact') }}" class="segment-card">
            <div class="segment-card__icon" aria-hidden="true">
              <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            </div>
            <h3 class="segment-card__title">Firemní akce</h3>
            <p class="segment-card__desc">Teambuildingy a firemní setkání mimo město.</p>
            <span class="segment-card__arrow">Poptat akci →</span>
          </a>
          <a href="{{ path('app_area') }}" class="segment-card">
            <div class="segment-card__icon" aria-hidden="true">
              <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 17l4-8 4 4 4-6 4 10"/><path d="M21 21H3"/></svg>
            </div>
            <h3 class="segment-card__title">Turisté a sportovci</h3>
            <p class="segment-card__desc">Stojíme na křižovatce turistických tras. Pěšky dojdete na Kelčský Javorník, Marušku i Sochovou, v okolí jsou trasy pro kola i běžky.</p>
            <span class="segment-card__arrow">Aktivity v okolí →</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section section--muted" aria-labelledby="about-heading">
      <div class="container">
        <div class="grid-2" style="align-items:center;gap:var(--space-16)">
          <div>
            <span class="eyebrow">O nás</span>
            <h2 id="about-heading" style="font-size:var(--text-xl);margin-top:var(--space-3);margin-bottom:var(--space-5)">Retro chata s moderními pokoji</h2>
            <p style="color:var(--color-text-secondary);margin-bottom:var(--space-5)">Chata Tesák-Čerňava stojí na kopci Tesák v nadmořské výšce 690 m n. m. v přírodní rezervaci v Hostýnských vrších. V roce 2012 prošla kompletní rekonstrukcí.</p>
            <p style="color:var(--color-text-secondary);margin-bottom:var(--space-8)">Kolem jsou bukové lesy, u chaty zahrada s dětským hřištěm, trampolínou a voliérou.</p>
            <a href="{{ path('app_accommodation') }}" class="btn btn--outline">Prohlédnout ubytování</a>
          </div>
          <div>
            <img
              src="{{ asset('images/views/img20231006100649.webp') }}"
              alt="Exteriér penzionu Tesák-Čerňava v zimě"
              style="border-radius:var(--radius-xl);width:100%;object-fit:cover;aspect-ratio:4/3;"
              loading="lazy" width="800" height="600">
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="benefits-heading">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Co nabízíme</span>
          <h2 id="benefits-heading">Co u nás najdete</h2>
        </div>
        <div class="feature-grid">
          <div class="feature-item">
            <div class="feature-item__icon" aria-hidden="true">
              <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <div>
              <h3 class="feature-item__title">Ubytování</h3>
              <p class="feature-item__desc">51 lůžek + přistýlky v útulných pokojích s koupelnou, většina s balkonem.</p>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-item__icon" aria-hidden="true">
              <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
            </div>
            <div>
              <h3 class="feature-item__title">Domácí kuchyně</h3>
              <p class="feature-item__desc">Domácí strava z čerstvých potravin, ne z průmyslových náhražek. Můžete si ale vařit i sami.</p>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-item__icon" aria-hidden="true">
              <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <h3 class="feature-item__title">Chráněná příroda</h3>
              <p class="feature-item__desc">Přírodní rezervace a ptačí oblast. Do bukových lesů vyrazíte přímo od chaty.</p>
            </div>
          </div>
          <div class="feature-item">
            <div class="feature-item__icon" aria-hidden="true">
              <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </div>
            <div>
              <h3 class="feature-item__title">Wellness a masáže</h3>
              <p class="feature-item__desc">Zkušený terapeut s praxí z Mariánských a Františkových Lázní a Karlových Varů.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--muted" aria-labelledby="rooms-heading">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Ubytování</span>
          <h2 id="rooms-heading">Pokoje a apartmány</h2>
          <p>Kapacita 51 lůžek + přistýlky. Od jednolůžkového pokoje po apartmán pro 11 osob.</p>
        </div>
        <div class="grid-3">
          {% for room in rooms %}
          {% set main = room.mainImage %}
          <article class="room-card" aria-label="{{ room.name }}">
            <div class="room-card__image">
              <img src="{{ main ? main.thumbnail : asset('images/rooms/' ~ room.slug ~ '/placeholder.webp') }}"
                alt="{{ main and main.alt ? main.alt : room.name ~ ' v penzionu Tesák-Čerňava' }}" loading="lazy" width="800" height="600">
            </div>
            <div class="room-card__body">
              <h3 class="room-card__title">{{ room.name }}</h3>
              <ul class="room-card__features">
                {% for feature in room.features %}
                <li class="room-card__feature">
                  <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  {{ feature }}
                </li>
                {% endfor %}
              </ul>
              {% if room.priceLabel %}
              <div class="room-card__divider"></div>
              <div class="room-card__pricing">
                <span class="room-card__price">{{ room.priceLabel }}</span>
                {% if room.priceUnit %}<span class="room-card__price-unit">{{ room.priceUnit }}</span>{% endif %}
              </div>
              {% endif %}
              <div class="room-card__cta">
                <a href="{{ path('app_accommodation', {pokoj: room.id}) }}#rezervace" class="btn btn--primary btn--full">Poptat pokoj</a>
              </div>
            </div>
          </article>
          {% endfor %}
        </div>
        <p class="text-center mt-8">
          <a href="{{ path('app_accommodation') }}" class="btn btn--outline">Zobrazit všechna ubytování</a>
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="kitchen-heading">
      <div class="container">
        <div class="grid-2" style="align-items:center;gap:var(--space-16)">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-3)">
            <img src="{{ asset('images/facilities/p1055117-hdr.webp') }}"
              alt="Kuchyně penzionu" loading="lazy" width="400" height="300"
              style="border-radius:var(--radius-lg);width:100%;aspect-ratio:4/3;object-fit:cover;">
            <img src="{{ asset('images/facilities/p1055164-hdr.webp') }}"
              alt="Jídelna penzionu" loading="lazy" width="400" height="300"
              style="border-radius:var(--radius-lg);width:100%;aspect-ratio:4/3;object-fit:cover;margin-top:var(--space-6);">
          </div>
          <div>
            <span class="eyebrow">Naše kuchyně</span>
            <h2 id="kitchen-heading" style="font-size:var(--text-xl);margin-top:var(--space-3);margin-bottom:var(--space-5)">Domácí strava</h2>
            <p style="color:var(--color-text-secondary);margin-bottom:var(--space-4)">Vaříme z čerstvých potravin, ne z náhražkových průmyslových produktů. Kdo chce, může si vařit i sám v kuchyňkách na patrech.</p>
            <p style="color:var(--color-text-secondary);margin-bottom:var(--space-6)">Náš personál má bohaté zkušenosti s pobyty dětí různých věkových kategorií a jejich stravováním. Pro skupiny vaříme 3× denně, k tomu 2 svačiny a pitný režim.</p>
            <a href="{{ path('app_groups') }}" class="btn btn--outline">Skupinové stravování →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--muted" aria-labelledby="area-heading">
      <div class="container">
        <div class="grid-2" style="align-items:center;gap:var(--space-16)">
          <div>
            <span class="eyebrow">Aktivity v okolí</span>
            <h2 id="area-heading" style="font-size:var(--text-xl);margin-top:var(--space-3);margin-bottom:var(--space-5)">Křižovatka turistických tras Hostýnských vrchů</h2>
            <p style="color:var(--color-text-secondary);margin-bottom:var(--space-6)">Od nás to máte na rozhlednu Kelčský Javorník 1,5 h, na rozhlednu Maruška 2 h, na Sochovou 1 h a na Svatý Hostýn 4 h. Bukový les začíná hned za plotem.</p>
            <ul style="display:flex;flex-direction:column;gap:var(--space-3);margin-bottom:var(--space-8)">
              <li class="room-card__feature" style="gap:var(--space-3)">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span style="font-size:var(--text-base)">Pěší turistika – značené trasy přímo od chaty</span>
              </li>
              <li class="room-card__feature" style="gap:var(--space-3)">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span style="font-size:var(--text-base)">Cyklistika a sportovní soustředění</span>
              </li>
              <li class="room-card__feature" style="gap:var(--space-3)">
                <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span style="font-size:var(--text-base)">Běžky – v zimě</span>
              </li>
            </ul>
            <a href="{{ path('app_area') }}" class="btn btn--primary">Aktivity v okolí</a>
          </div>
          <div>
            <img src="{{ asset('images/facilities/img_20250802_102255.webp') }}"
              alt="Křižovatka turistických tras Tesák" loading="lazy" width="800" height="600"
              style="border-radius:var(--radius-xl);width:100%;object-fit:cover;aspect-ratio:4/3;">
          </div>
        </div>
      </div>
    </section>


    <section class="cta-band" aria-labelledby="cta-heading">
      <div class="container">
        <h2 id="cta-heading">Těšíme se na Vaši návštěvu</h2>
        <p>Volný termín si vyberte v rezervaci, nebo nám zavolejte.</p>
        <div class="btn-group" style="justify-content:center">
          <a href="{{ path('app_accommodation') }}#rezervace" class="btn btn--primary">Rezervovat pobyt</a>
          <a href="{{ path('app_groups') }}" class="btn btn--outline-white">Školy v přírodě</a>
        </div>
      </div>
    </section>

{% endblock %}
