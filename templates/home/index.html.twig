      <div class="form__step active" id="step1">
        <h3 class="form__stitle">Co potřebuješ?</h3>
        <p class="form__ssub">Vyber typ projektu.</p>
        <div class="rcards">
          <div class="rcard">
            <input type="radio" name="type" id="t1" value="web">
            <label for="t1"><span class="rcard__title">Tvorba webu</span><span class="rcard__desc">Firemní web, portfolio, landing page</span></label>
          </div>
          <div class="rcard">
            <input type="radio" name="type" id="t2" value="eshop">
            <label for="t2"><span class="rcard__title">Tvorba e-shopu</span><span class="rcard__desc">Shoptet, vlastní e-shop, migrace</span></label>
          </div>
          <div class="rcard">
            <input type="radio" name="type" id="t3" value="programovani">
            <label for="t3"><span class="rcard__title">Programování na míru</span><span class="rcard__desc">Integrace, systémy, API</span></label>
          </div>
          <div class="rcard">
            <input type="radio" name="type" id="t4" value="konzultace">
            <label for="t4"><span class="rcard__title">Konzultace</span><span class="rcard__desc">Audit webu, poradenství</span></label>
          </div>
        </div>
        <div class="form__nav">
          <span></span>
          <button class="btn btn--accent" onclick="nextStep(1)">Pokračovat →</button>
        </div>
      </div>

      <div class="form__step" id="step2">
        <h3 class="form__stitle">Rozpočet a termín</h3>
        <p class="form__ssub">Pomůže mi připravit relevantní nabídku.</p>
        <div class="ffield">
          <label for="budget">Orientační rozpočet</label>
          <select id="budget" name="budget">
            <option value="">Vyber rozsah</option>
            <option>Do 15 000 Kč</option>
            <option>15 000 – 30 000 Kč</option>
            <option>30 000 – 60 000 Kč</option>
            <option>60 000 Kč a více</option>
            <option>Zatím nevím</option>
          </select>
        </div>
        <div class="ffield">
          <label for="deadline">Požadovaný termín spuštění</label>
          <select id="deadline" name="deadline">
            <option value="">Vyber termín</option>
            <option>Do 2 týdnů</option>
            <option>Do 1 měsíce</option>
            <option>Do 3 měsíců</option>
            <option>Bez pevného termínu</option>
          </select>
        </div>
        <div class="form__nav">
          <button class="form__back" onclick="prevStep(2)">← Zpět</button>
          <button class="btn btn--accent" onclick="nextStep(2)">Pokračovat →</button>
        </div>
      </div>

      <div class="form__step" id="step3">
        <h3 class="form__stitle">Tvůj současný web</h3>
        <p class="form__ssub">Nepovinné, ale pomůže mi připravit lepší demo.</p>
        <div class="ffield">
          <label for="url">URL současného webu (pokud existuje)</label>
          <input type="url" id="url" name="url" placeholder="https://">
        </div>
        <label class="fchk">
          <input type="checkbox" id="hasBranding" name="hasBranding">
          <span class="fchk__box"></span>
          Mám logo a grafický manuál
        </label>
        <label class="fchk">
          <input type="checkbox" id="hasTexts" name="hasTexts">
          <span class="fchk__box"></span>
          Mám připravené texty
        </label>
        <div class="form__nav">
          <button class="form__back" onclick="prevStep(3)">← Zpět</button>
          <button class="btn btn--accent" onclick="nextStep(3)">Pokračovat →</button>
        </div>
      </div>

      <div class="form__step" id="step4">
        <h3 class="form__stitle">Kontaktní údaje</h3>
        <p class="form__ssub">Ozvu se do 24 h.</p>
        <div class="frow">
          <div class="ffield">
            <label for="fname">Jméno</label>
            <input type="text" id="fname" name="fname" placeholder="Jan Novák" required>
          </div>
          <div class="ffield">
            <label for="company">Firma / projekt</label>
            <input type="text" id="company" name="company" placeholder="Novák s.r.o.">
          </div>
        </div>
        <div class="ffield">
          <label for="email">E-mail *</label>
          <input type="email" id="email" name="email" placeholder="jan@firma.cz" required>
        </div>
        <div class="ffield">
          <label for="phone">Telefon (nepovinné)</label>
          <input type="tel" id="phone" name="phone" placeholder="+420 777 000 000">
        </div>
        <div class="ffield">
          <label for="note">Poznámka (nepovinné)</label>
          <textarea id="note" name="note" placeholder="Napiš cokoliv — co řešíš, co se ti nelíbí na současném webu, termín, dotazy…" rows="4"></textarea>
        </div>
        <div class="form__nav">
          <button class="form__back" onclick="prevStep(4)">← Zpět</button>
          <button class="btn btn--accent btn--lg" onclick="submitForm()">Odeslat a získat nabídku →</button>
        </div>
        <p style="font-family:var(--mono);font-size:.65rem;color:var(--muted);margin-top:1rem;line-height:1.6">
          Odesláním formuláře souhlasíte se zpracováním osobních údajů za účelem přípravy nabídky.
          Podrobnosti viz <a href="/zasady-ochrany-osobnich-udaju" style="color:var(--accent)">Zásady ochrany osobních údajů</a>.
        </p>
      </div>
    </div>

    <div class="form__success" id="formSuccess">
      <div class="form__success-ico">✓</div>
      <h3>Odesláno<span class="accent">.</span></h3>
      <p>Ozvu se do 24 hodin.</p>
    </div>
  </div>
</section>

{# ── FOOTER ── #}
<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <div>
        <div class="footer__logo">JC<span class="accent">.</span></div>
        <p class="footer__tagline">Weby a e-shopy na míru. Osobně, od A do Z.</p>
      </div>
      <div>
        <p class="footer__coltitle">Služby</p>
        <ul class="footer__links">
          <li><a href="#sluzby">Tvorba webu</a></li>
          <li><a href="#sluzby">Tvorba e-shopu</a></li>
          <li><a href="#sluzby">Programování na míru</a></li>
          <li><a href="#sluzby">Správa webu</a></li>
        </ul>
      </div>
      <div>
        <p class="footer__coltitle">Kontakt</p>
        <ul class="footer__links">
          <li><a href="mailto:{{ business.email }}">{{ business.email }}</a></li>
          <li><a href="tel:{{ business.phone }}">{{ business.phone_display }}</a></li>
          {% if business.linkedin %}<li><a href="{{ business.linkedin }}" target="_blank" rel="noopener">LinkedIn</a></li>{% endif %}
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <span class="footer__copy">© {{ "now"|date("Y") }} {{ business.name }} — IČO {{ business.ico }} — {{ business.city }}</span>
      <span class="footer__copy"><a href="/zasady-ochrany-osobnich-udaju" style="color:inherit;opacity:.6">Zásady ochrany osobních údajů</a></span>
    </div>
  </div>
</footer>

{# ── STICKY MOBILE ── #}
<div class="sticky">
  <a href="#kontakt" class="btn btn--accent">Získat demo zdarma →</a>
</div>

<script>
(function(){
  var nav = document.getElementById('nav');
  window.addEventListener('scroll', function(){
    nav.classList.toggle('scrolled', window.scrollY > 60);
  }, {passive:true});

  var toggle = document.getElementById('navToggle');
  var mobile = document.getElementById('navMobile');
  toggle.addEventListener('click', function(){
    var open = mobile.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open);
  });
  mobile.querySelectorAll('a').forEach(function(a){
    a.addEventListener('click', function(){ mobile.classList.remove('open'); });
  });

  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, {threshold:0.1});
  document.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });

  function show(n){
    [1,2,3,4].forEach(function(i){
      var el = document.getElementById('step'+i);
      if(el) el.classList.toggle('active', i===n);
    });
    var pct = Math.round((n/4)*100);
    document.getElementById('progBar').style.width = pct + '%';
    document.getElementById('stepLabel').textContent = 'Krok ' + n + ' ze 4';
    document.getElementById('stepPct').textContent = pct + ' %';
  }

  window.nextStep = function(from){
    if(from === 1){
      if(!document.querySelector('input[name="type"]:checked')){ alert('Vyber typ projektu.'); return; }
    }
    show(from + 1);
  };

  window.prevStep = function(from){
    if(from > 1) show(from - 1);
  };

  window.submitForm = function(){
    console.log('[form] submitForm called');
    var emailVal = document.getElementById('email').value;
    if(!emailVal){ alert('Vyplň e-mail.'); return; }
    var btn = document.querySelector('#step4 .btn--accent');
    btn.disabled = true; btn.textContent = 'Odesílám…';
    var payload = {
      type: (document.querySelector('input[name="type"]:checked') || {}).value || '',
      budget: document.querySelector('select[name="budget"]').value,
      deadline: document.querySelector('select[name="deadline"]').value,
      url: document.querySelector('input[name="url"]').value,
      hasLogo: document.querySelector('input[name="hasBranding"]').checked,
      hasTexts: document.querySelector('input[name="hasTexts"]').checked,
      name: document.querySelector('input[name="fname"]').value,
      company: document.querySelector('input[name="company"]').value,
      email: emailVal,
      phone: document.querySelector('input[name="phone"]').value,
      note: document.querySelector('textarea[name="note"]').value,
    };
    console.log('[form] payload', payload);
    fetch('/api/contact', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload)})
      .then(function(r){ console.log('[form] response', r.status); if(!r.ok) throw new Error(r.status); document.getElementById('formContainer').style.display = 'none'; document.getElementById('formSuccess').classList.add('show'); })
      .catch(function(e){ console.error('[form] error', e); alert('Nepodařilo se odeslat. Zkus to prosím znovu.'); btn.disabled = false; btn.textContent = 'Odeslat a získat nabídku →'; });
  };
})();
</script>

{% endblock %}
