{% extends 'base.html.twig' %}

{% block title %}Ceník ubytování | Tesák-Čerňava{% endblock %}
{% block description %}Aktuální ceník ubytování, stravování a wellness penzionu Tesák-Čerňava. Hostýnské vrchy, Chvalčov.{% endblock %}
{% block og_title %}Ceník | Tesák-Čerňava{% endblock %}
{% block og_description %}Aktuální ceník ubytování, stravování a wellness penzionu Tesák-Čerňava.{% endblock %}

{% block body %}

    <header class="page-header">
      <img class="page-header__bg"
        src="{{ asset('images/facilities/img_20250802_102255.webp') }}"
        alt="" loading="eager" aria-hidden="true">
      <div class="container">
        <div class="page-header__content">
          <span class="page-header__eyebrow">Ceník</span>
          <h1 class="page-header__title">Ceník ubytování a služeb</h1>
          <p class="page-header__lead">Aktuální ceny ubytování, stravování, skupinových balíčků a wellness. Ceny jsou platné pro sezonu 2026.</p>
        </div>
      </div>
    </header>

    <section class="section" aria-labelledby="price-rooms-heading">
      <div class="container">
        <h2 id="price-rooms-heading" style="font-size:var(--text-xl);margin-bottom:var(--space-3)">Ubytování</h2>
        <p style="color:var(--color-text-secondary);margin-bottom:var(--space-8)">Kapacita: 51 lůžek + přistýlky. Check-in od 14:00 (nebo dle dohody), check-out do 10:00.</p>

        <div class="price-table-wrap">
          <table class="price-table">
            <thead>
              <tr>
                <th scope="col">Typ pokoje</th>
                <th scope="col">Vybavení</th>
                <th scope="col">2+ nocí</th>
                <th scope="col">1 noc</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row" style="font-weight:600">Jednolůžkový pokoj</th>
                <td>Povlečení, koupelna, ručníky, WC, balkon</td>
                <td class="price-cell">650 Kč</td>
                <td class="price-cell">950 Kč</td>
              </tr>
              <tr>
                <th scope="row" style="font-weight:600">Dvoulůžkový (sdílená koupelna)</th>
                <td>Povlečení, ručníky, WC, balkon, sdílená kuchyňka</td>
                <td class="price-cell">800 Kč</td>
                <td class="price-cell">1 100 Kč</td>
              </tr>
              <tr>
                <th scope="row" style="font-weight:600">Pokoj s manž. postelí, vlastní koupelna</th>
                <td>TV, vlastní koupelna, ručníky, WC, balkon, sdílená kuchyňka</td>
                <td class="price-cell">1 100 Kč</td>
                <td class="price-cell">1 400 Kč</td>
              </tr>
              <tr>
                <th scope="row" style="font-weight:600">Velký rodinný pokoj (č. 11, 21)</th>
                <td>Manž. postel + palanda, koupelna, ručníky, WC, balkon, sdílená kuchyňka</td>
                <td class="price-cell">2 100 Kč</td>
                <td class="price-cell">2 400 Kč</td>
              </tr>
              <tr>
                <th scope="row" style="font-weight:600">Palanda + 2 lůžka, vlastní koupelna (č. 16)</th>
                <td>Vlastní koupelna, ručníky, WC, balkon, sdílená kuchyňka</td>
                <td class="price-cell">1 890 Kč</td>
                <td class="price-cell">2 190 Kč</td>
              </tr>
              <tr>
                <th scope="row" style="font-weight:600">Rodinný dvoupokoj (č. 16+17)</th>
                <td>1× manž. + 1× palanda + 2× lůžko, TV, vlastní koupelna, balkon</td>
                <td class="price-cell">2 490 Kč</td>
                <td class="price-cell">2 690 Kč</td>
              </tr>
              <tr>
                <th scope="row" style="font-weight:600">Apartmán přízemí (až 9 osob)</th>
                <td>3× palanda + jednolůžko + gauč, kuchyňský kout, koupelna s vanou, herna NERF</td>
                <td class="price-cell">590 Kč/os.</td>
                <td class="price-cell">780 Kč/os.</td>
              </tr>
              <tr>
                <th scope="row" style="font-weight:600">Apartmán 2 ložnice (až 11 osob)</th>
                <td>2× manž. postel + palanda + 2× gauč, TV, kuchyňský kout, koupelna, balkon</td>
                <td class="price-cell">3 990 Kč</td>
                <td class="price-cell">7 980 Kč</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="alert alert--info mt-6">
          <strong>Přezůvky s sebou.</strong> Malý pes do 4 kg: 150 Kč/noc. Postýlka pro děti do 2 let: zdarma. Ceny se mohou změnit.
        </div>
      </div>
    </section>

    <section class="section section--muted" aria-labelledby="price-food-heading">
      <div class="container">
        <h2 id="price-food-heading" style="font-size:var(--text-xl);margin-bottom:var(--space-8)">Stravování</h2>
        <div class="grid-2" style="gap:var(--space-10)">
          <div>
            <h3 style="font-size:var(--text-md);margin-bottom:var(--space-5)">Individuální hosté</h3>
            <div class="price-table-wrap">
              <table class="price-table">
                <thead>
                  <tr>
                    <th scope="col">Typ</th>
                    <th scope="col">Cena</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Snídaně — dítě do 12 let</td>
                    <td class="price-cell">130 Kč</td>
                  </tr>
                  <tr>
                    <td>Snídaně — dospělý</td>
                    <td class="price-cell">160 Kč</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p style="font-size:var(--text-sm);color:var(--color-text-muted);margin-top:var(--space-3)">Snídaně po dohodě. Možnost vlastního vaření v kuchyňce.</p>
          </div>
          <div>
            <h3 style="font-size:var(--text-md);margin-bottom:var(--space-5)">Skupiny dětí</h3>
            <div style="background:var(--color-surface-card);border-radius:var(--radius-xl);padding:var(--space-6);border:2px solid var(--color-primary-200)">
              <div style="display:flex;align-items:baseline;gap:var(--space-2);margin-bottom:var(--space-2)">
                <span style="font-family:var(--font-heading);font-size:var(--text-2xl);font-weight:700;color:var(--color-primary-600)">748 Kč</span>
                <span style="color:var(--color-text-muted);font-size:var(--text-sm)">/dítě/den</span>
              </div>
              <p style="color:var(--color-success-text);font-weight:500;font-size:var(--text-sm);margin-bottom:var(--space-5)">Pondělí–pátek: 2 990 Kč / dítě</p>
              <ul style="display:flex;flex-direction:column;gap:var(--space-2)">
                <li style="font-size:var(--text-sm);display:flex;align-items:center;gap:var(--space-2)">
                  <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  3× denně teplé jídlo
                </li>
                <li style="font-size:var(--text-sm);display:flex;align-items:center;gap:var(--space-2)">
                  <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  2× denně svačina
                </li>
                <li style="font-size:var(--text-sm);display:flex;align-items:center;gap:var(--space-2)">
                  <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  Pitný režim po celý den
                </li>
                <li style="font-size:var(--text-sm);display:flex;align-items:center;gap:var(--space-2)">
                  <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  Na 10 dětí 1 dospělý zdarma (při plném obsazení)
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="price-wellness-heading">
      <div class="container">
        <h2 id="price-wellness-heading" style="font-size:var(--text-xl);margin-bottom:var(--space-3)">Wellness a masáže</h2>
        <p style="color:var(--color-text-secondary);margin-bottom:var(--space-8)">Zkušený terapeut s praxí z Mariánských Lázní, Františkových Lázní a Karlových Varů. Dostupné i bez ubytování.</p>
        <div class="wellness-list">
          <div class="wellness-item">
            <span class="wellness-item__name">Klasická masáž</span>
            <div class="wellness-item__prices">
              <div class="wellness-item__price"><strong>400 Kč</strong><span>30 min</span></div>
              <div class="wellness-item__price"><strong>800 Kč</strong><span>60 min</span></div>
            </div>
          </div>
          <div class="wellness-item">
            <span class="wellness-item__name">Zábal z nahřátých obilných zrn</span>
            <div class="wellness-item__prices">
              <div class="wellness-item__price"><strong>250 Kč</strong><span>20 min</span></div>
              <div class="wellness-item__price"><strong>450 Kč</strong><span>40 min</span></div>
            </div>
          </div>
          <div class="wellness-item">
            <span class="wellness-item__name">Horké kameny</span>
            <div class="wellness-item__prices">
              <div class="wellness-item__price"><strong>700 Kč</strong><span>30 min</span></div>
              <div class="wellness-item__price"><strong>1 400 Kč</strong><span>60 min</span></div>
            </div>
          </div>
          <div class="wellness-item">
            <span class="wellness-item__name">Baňkování</span>
            <div class="wellness-item__prices">
              <div class="wellness-item__price"><strong>300 Kč</strong><span>20 min</span></div>
            </div>
          </div>
          <div class="wellness-item">
            <span class="wellness-item__name">Reflexní masáž plosky nohou</span>
            <div class="wellness-item__prices">
              <div class="wellness-item__price"><strong>600 Kč</strong><span>30 min</span></div>
              <div class="wellness-item__price"><strong>1 200 Kč</strong><span>60 min</span></div>
            </div>
          </div>
          <div class="wellness-item">
            <span class="wellness-item__name">Masáže dětí a těhotných žen</span>
            <div class="wellness-item__prices">
              <div class="wellness-item__price"><strong>400 Kč</strong><span>30 min</span></div>
              <div class="wellness-item__price"><strong>800 Kč</strong><span>60 min</span></div>
            </div>
          </div>
          <div class="wellness-item">
            <span class="wellness-item__name">Sportovní masáž</span>
            <div class="wellness-item__prices">
              <div class="wellness-item__price"><strong>500 Kč</strong><span>30 min</span></div>
              <div class="wellness-item__price"><strong>1 000 Kč</strong><span>60 min</span></div>
            </div>
          </div>
          <div class="wellness-item">
            <span class="wellness-item__name">Akupresurní odblokování krční páteře</span>
            <div class="wellness-item__prices">
              <div class="wellness-item__price"><strong>600 Kč</strong><span>30 min</span></div>
              <div class="wellness-item__price"><strong>1 200 Kč</strong><span>60 min</span></div>
            </div>
          </div>
          <div class="wellness-item">
            <span class="wellness-item__name">Měkké stabilizační techniky</span>
            <div class="wellness-item__prices">
              <div class="wellness-item__price"><strong>400 Kč</strong><span>30 min</span></div>
            </div>
          </div>
          <div class="wellness-item">
            <span class="wellness-item__name">Energetická masáž Reiki</span>
            <div class="wellness-item__prices">
              <div class="wellness-item__price"><strong>600 Kč</strong><span>30 min</span></div>
              <div class="wellness-item__price"><strong>1 200 Kč</strong><span>60 min</span></div>
            </div>
          </div>
          <div class="wellness-item">
            <span class="wellness-item__name">Jógovo-rehabilitační cvičení</span>
            <div class="wellness-item__prices">
              <div class="wellness-item__price"><strong>400 Kč</strong><span>30 min</span></div>
            </div>
          </div>
        </div>
        <p class="mt-6 text-center">
          <a href="{{ path('app_wellness') }}" class="btn btn--accent">Rezervovat masáž</a>
        </p>
      </div>
    </section>

    <section class="cta-band" aria-labelledby="cta-heading">
      <div class="container">
        <h2 id="cta-heading">Máte dotaz k cenám?</h2>
        <p>Rádi Vám připravíme individuální nabídku na míru.</p>
        <a href="{{ path('app_contact') }}" class="btn btn--primary">Napsat nám</a>
      </div>
    </section>

{% endblock %}
