{% extends 'base.html.twig' %}

{% block title %}Ceník ubytování | Tesák-Čerňava{% endblock %}
{% block description %}Aktuální ceník ubytování, stravování a wellness penzionu Tesák-Čerňava. Hostýnské vrchy, Chvalčov.{% endblock %}
{% block og_title %}Ceník | Tesák-Čerňava{% endblock %}
{% block og_description %}Aktuální ceník ubytování, stravování a wellness penzionu Tesák-Čerňava.{% endblock %}

{% block body %}

    <header class="page-header">
      <img class="page-header__bg"
        src="{{ asset('images/facilities/img_20250802_102255.webp') }}"
        alt="" loading="eager" aria-hidden="true">
      <div class="container">
        <div class="page-header__content">
          <span class="page-header__eyebrow">Ceník</span>
          <h1 class="page-header__title">Ceník ubytování a služeb</h1>
          <p class="page-header__lead">Aktuální ceny ubytování, stravování, skupinových balíčků a wellness. Ceny jsou platné pro sezonu 2026.</p>
        </div>
      </div>
    </header>

    <section class="section" aria-labelledby="price-rooms-heading">
      <div class="container">
        <h2 id="price-rooms-heading" style="font-size:var(--text-xl);margin-bottom:var(--space-3)">Ubytování</h2>
        <p style="color:var(--color-text-secondary);margin-bottom:var(--space-8)">Kapacita: 51 lůžek + přistýlky. Check-in od 14:00 (nebo dle dohody), check-out do 10:00.</p>

        <div class="price-table-wrap">
          <table class="price-table">
            <thead>
              <tr>
                <th scope="col">Typ pokoje</th>
                <th scope="col">Vybavení</th>
                <th scope="col">2+ nocí</th>
                <th scope="col">1 noc</th>
              </tr>
            </thead>
            <tbody>
              {% for room in rooms %}
              {% set suffix = room.perPerson ? ' Kč/os.' : ' Kč' %}
              <tr>
                <th scope="row" style="font-weight:600">{{ room.name }}</th>
                <td>{{ room.features|join(', ') }}</td>
                <td class="price-cell">{{ room.price|number_format(0, ',', ' ') }}{{ suffix }}</td>
                <td class="price-cell">{{ room.priceSingleNight ? room.priceSingleNight|number_format(0, ',', ' ') ~ suffix : '—' }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <div class="alert alert--info mt-6">
          <strong>V ceně každého pokoje:</strong> povlečení, ručníky, WC. <strong>Přezůvky s sebou.</strong> Malý pes do 4 kg: 190 Kč/noc. Postýlka pro děti do 2 let: zdarma. Ceny se mohou změnit.
        </div>
      </div>
    </section>

    <section class="section section--muted" aria-labelledby="price-food-heading">
      <div class="container">
        <h2 id="price-food-heading" style="font-size:var(--text-xl);margin-bottom:var(--space-8)">Stravování</h2>
        <div class="grid-2" style="gap:var(--space-10)">
          <div>
            <h3 style="font-size:var(--text-md);margin-bottom:var(--space-5)">Individuální hosté</h3>
            <div class="price-table-wrap">
              <table class="price-table">
                <thead>
                  <tr>
                    <th scope="col">Typ</th>
                    <th scope="col">Cena</th>
                  </tr>
                </thead>
                <tbody>
                  {% for m in meals|filter(m => not m.highlighted) %}
                  <tr>
                    <td>{{ m.name }}</td>
                    <td class="price-cell">{{ m.price|number_format(0, ',', ' ') }} Kč{{ m.priceUnit }}</td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            <p style="font-size:var(--text-sm);color:var(--color-text-muted);margin-top:var(--space-3)">Snídaně po dohodě. Možnost vlastního vaření v kuchyňce.</p>
          </div>
          <div>
            <h3 style="font-size:var(--text-md);margin-bottom:var(--space-5)">Skupiny dětí</h3>
            {% for m in meals|filter(m => m.highlighted) %}
            <div style="background:var(--color-surface-card);border-radius:var(--radius-xl);padding:var(--space-6);border:2px solid var(--color-primary-200);margin-bottom:var(--space-4)">
              <div style="display:flex;align-items:baseline;gap:var(--space-2);margin-bottom:var(--space-2)">
                <span style="font-family:var(--font-heading);font-size:var(--text-2xl);font-weight:700;color:var(--color-primary-600)">{{ m.price|number_format(0, ',', ' ') }} Kč</span>
                {% if m.priceUnit %}<span style="color:var(--color-text-muted);font-size:var(--text-sm)">{{ m.priceUnit }}</span>{% endif %}
              </div>
              {% if m.note %}<p style="color:var(--color-success-text);font-weight:500;font-size:var(--text-sm);margin-bottom:var(--space-5)">{{ m.note }}</p>{% endif %}
              {% if m.features %}
              <ul style="display:flex;flex-direction:column;gap:var(--space-2)">
                {% for feat in m.features %}
                <li style="font-size:var(--text-sm);display:flex;align-items:center;gap:var(--space-2)">
                  <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--color-primary-500)" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  {{ feat }}
                </li>
                {% endfor %}
              </ul>
              {% endif %}
            </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="price-wellness-heading">
      <div class="container">
        <h2 id="price-wellness-heading" style="font-size:var(--text-xl);margin-bottom:var(--space-3)">Wellness a masáže</h2>
        <p style="color:var(--color-text-secondary);margin-bottom:var(--space-8)">Zkušený terapeut s praxí z Mariánských Lázní, Františkových Lázní a Karlových Varů. Dostupné i bez ubytování.</p>
        <div class="wellness-list">
          {% for m in massages %}
          <div class="wellness-item">
            <span class="wellness-item__name">{{ m.name }}{% if m.note %} <small style="font-weight:400;color:var(--color-text-muted)">{{ m.note }}</small>{% endif %}</span>
            <div class="wellness-item__prices">
              {% for p in m.prices %}
              <div class="wellness-item__price"><strong>{{ p.price|number_format(0, ',', ' ') }} Kč</strong><span>{{ p.minutes }} min</span></div>
              {% endfor %}
            </div>
          </div>
          {% endfor %}
        </div>
        <p class="mt-6 text-center">
          <a href="{{ path('app_wellness') }}" class="btn btn--accent">Rezervovat masáž</a>
        </p>
      </div>
    </section>

    <section class="cta-band" aria-labelledby="cta-heading">
      <div class="container">
        <h2 id="cta-heading">Máte dotaz k cenám?</h2>
        <p>Rádi Vám připravíme individuální nabídku na míru.</p>
        <a href="{{ path('app_contact') }}" class="btn btn--primary">Napsat nám</a>
      </div>
    </section>

{% endblock %}
