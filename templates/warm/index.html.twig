{% extends 'base.html.twig' %}

{% block title %}Tvorba webu pro živnostníky — Jan Červinka{% endblock %}

{% block stylesheets %}
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="description" content="Weby a e-shopy na míru pro české živnostníky. Fixní cena, demo zdarma do 24 h, každý projekt dělám osobně.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Mono:wght@400&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{font-size:16px;scroll-behavior:smooth}

:root{
  --bg:#F4F5F4;
  --bg2:#E9EBEA;
  --bg3:#DDDFE0;
  --text:#1A1F1A;
  --muted:rgba(26,31,26,.5);
  --muted2:rgba(26,31,26,.28);
  --accent:#16A34A;
  --accent-bg:rgba(22,163,74,.08);
  --accent-dark:#15803D;
  --border:rgba(26,31,26,.1);
  --borderm:rgba(26,31,26,.18);
  --shadow:0 1px 3px rgba(28,25,23,.06),0 4px 16px rgba(28,25,23,.06);
  --shadow-lg:0 4px 6px rgba(28,25,23,.04),0 12px 40px rgba(28,25,23,.1);
  --ff:'Plus Jakarta Sans',sans-serif;
  --sans:'Plus Jakarta Sans',sans-serif;
  --mono:'DM Mono',monospace;
  --max:1280px;
  --pad:clamp(1.25rem,4vw,3rem);
  --r:12px;
}

body{background:var(--bg);color:var(--text);font-family:var(--sans);line-height:1.65;overflow-x:hidden;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
ul{list-style:none}
button{cursor:pointer;font-family:var(--sans);border:none;background:none;color:inherit}
.wrap{max-width:var(--max);margin:0 auto;padding:0 var(--pad)}
.label{font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.tag{display:inline-flex;align-items:center;gap:.5rem;font-family:var(--mono);font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);background:var(--accent-bg);padding:.35rem .75rem;border-radius:99px;margin-bottom:1.25rem}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.9rem 1.85rem;font-family:var(--sans);font-weight:600;font-size:.95rem;transition:all .2s ease;border:1.5px solid transparent;border-radius:99px;cursor:pointer;white-space:nowrap}
.btn--accent{background:var(--accent);color:#fff;border-color:var(--accent)}
.btn--accent:hover{background:var(--accent-dark);border-color:var(--accent-dark);transform:translateY(-1px);box-shadow:0 4px 16px rgba(22,163,74,.3)}
.btn--outline{background:transparent;color:var(--text);border-color:var(--borderm)}
.btn--outline:hover{border-color:var(--text);transform:translateY(-1px)}
.btn--lg{padding:1.1rem 2.25rem;font-size:1.05rem}
.reveal{opacity:0;transform:translateY(20px);transition:opacity .6s cubic-bezier(.16,1,.3,1),transform .6s cubic-bezier(.16,1,.3,1)}
.reveal.in{opacity:1;transform:translateY(0)}
.reveal.d1{transition-delay:.08s}
.reveal.d2{transition-delay:.16s}
.reveal.d3{transition-delay:.24s}

/* NAV */
.nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:1rem 0;transition:all .3s}
.nav.scrolled{background:rgba(244,245,244,.92);backdrop-filter:blur(16px);box-shadow:0 1px 0 var(--border)}
.nav__inner{display:flex;align-items:center;gap:2rem}
.nav__logo{font-family:var(--ff);font-weight:700;font-size:1.3rem;margin-right:auto}
.nav__logo span{color:var(--accent)}
.nav__links{display:flex;align-items:center;gap:2rem}
.nav__links a{font-size:.88rem;font-weight:500;color:var(--muted);transition:color .2s}
.nav__links a:hover{color:var(--text)}
.nav__toggle{display:none;flex-direction:column;gap:5px;padding:.5rem}
.nav__toggle span{display:block;width:22px;height:1.5px;background:var(--text);border-radius:2px;transition:all .3s}
.nav__mobile{display:none;flex-direction:column;padding:1.5rem var(--pad);background:var(--bg);border-top:1px solid var(--border)}
.nav__mobile a{padding:.75rem 0;font-weight:600;font-size:1.1rem;border-bottom:1px solid var(--border)}
.nav__mobile .btn{margin-top:1rem;width:100%;justify-content:center}
@media(max-width:768px){.nav__links,.nav__cta{display:none}.nav__toggle{display:flex}.nav__mobile.open{display:flex}}

/* HERO */
.hero{min-height:100vh;display:flex;flex-direction:column;padding-top:5rem;position:relative;overflow:hidden;background:var(--bg)}
.hero__inner{flex:1;display:grid;grid-template-columns:1.05fr 1fr;gap:clamp(3rem,5vw,6rem);align-items:center;padding-top:4vh;padding-bottom:4rem}
.hero__text{display:flex;flex-direction:column;gap:1.75rem}
.hero__name{font-family:var(--mono);font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.hero__h1{font-family:var(--ff);font-weight:700;font-style:normal;font-size:clamp(2.75rem,6vw,6rem);line-height:1;letter-spacing:-.02em}
.hero__h1 em{color:var(--accent);font-style:normal}
.hero__sub{font-size:clamp(1rem,1.5vw,1.15rem);color:var(--muted);max-width:40ch;line-height:1.65}
.hero__ctas{display:flex;align-items:center;gap:1rem;flex-wrap:wrap}
.hero__checks{display:flex;flex-direction:column;gap:.35rem}
.hero__checks li{font-family:var(--mono);font-size:.72rem;color:var(--muted);display:flex;align-items:center;gap:.5rem}
.hero__checks li::before{content:'✓';color:var(--accent);font-weight:700}
.hero__photo{position:relative}
.hero__photo img{width:100%;min-height:480px;object-fit:cover;object-position:top;border-radius:clamp(16px,3vw,28px);box-shadow:var(--shadow-lg)}
.hero__pholder{width:100%;min-height:520px;background:var(--bg2);border-radius:clamp(16px,3vw,28px);display:flex;flex-direction:column;justify-content:flex-end;padding:2rem;position:relative;overflow:hidden}
.hero__pholder::before{content:'';position:absolute;inset:0;border:2px dashed rgba(22,163,74,.25);border-radius:inherit;margin:.75rem;pointer-events:none}
.hero__pholder-badge{position:absolute;top:1.5rem;left:1.5rem;background:var(--accent-bg);border:1px solid rgba(22,163,74,.3);color:var(--accent);font-family:var(--mono);font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;padding:.3rem .65rem;border-radius:99px}
.hero__pholder-label{font-family:var(--mono);font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin-bottom:.65rem;opacity:.7}
.hero__pholder-prompt{font-family:var(--mono);font-size:.63rem;line-height:1.55;color:rgba(28,25,23,.35)}
.hero__niches{border-top:1px solid var(--border);padding:2rem 0}
.niche-strip{display:flex;align-items:center;gap:clamp(1.5rem,3vw,3rem);flex-wrap:wrap;margin-top:.85rem}
.niche-strip span{font-family:var(--mono);font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted2);white-space:nowrap}
@media(max-width:900px){.hero__inner{grid-template-columns:1fr;gap:2.5rem;padding-top:2.5rem}.hero__photo{order:-1}.hero__pholder{min-height:55vw}}

/* ABOUT */
.about{padding:clamp(5rem,10vw,9rem) 0}
.about__grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(3rem,6vw,6rem);align-items:center}
.about__h2{font-family:var(--ff);font-weight:700;font-style:normal;font-size:clamp(2rem,4.5vw,4rem);letter-spacing:-.02em;line-height:1.05;margin-bottom:1.5rem}
.about__p{color:var(--muted);font-size:.95rem;line-height:1.72;max-width:44ch;margin-bottom:1rem}
.about__facts{display:flex;flex-direction:column;gap:.75rem;margin-top:1.75rem;padding-top:1.75rem;border-top:1px solid var(--border)}
.about__facts li{font-size:.88rem;color:var(--muted);display:flex;align-items:center;gap:.6rem}
.about__facts li strong{color:var(--accent);font-family:var(--ff);font-style:normal;font-size:1.05rem}
.about__photos{display:grid;grid-template-rows:1.6fr 1fr;gap:1rem;height:clamp(460px,50vw,640px)}
.aphoto{border-radius:var(--r);overflow:hidden;position:relative}
.aphoto img{width:100%;height:100%;object-fit:cover;transition:transform .6s}
.aphoto:hover img{transform:scale(1.03)}
.apholder{width:100%;height:100%;background:var(--bg2);border-radius:var(--r);display:flex;flex-direction:column;justify-content:flex-end;padding:1.5rem;position:relative;overflow:hidden}
.apholder::before{content:'';position:absolute;inset:0;border:2px dashed rgba(22,163,74,.2);border-radius:inherit;margin:.65rem;pointer-events:none}
.apholder__tag{font-family:var(--mono);font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin-bottom:.6rem;display:block;opacity:.8}
.apholder__prompt{font-family:var(--mono);font-size:.63rem;line-height:1.55;color:rgba(28,25,23,.4)}
@media(max-width:900px){.about__grid{grid-template-columns:1fr}.about__photos{height:auto;grid-template-rows:auto;grid-template-columns:1fr 1fr}.aphoto,.apholder{min-height:220px}}

/* SECTION */
.section{padding:clamp(5rem,10vw,9rem) 0}
.section__hd{margin-bottom:clamp(2.5rem,5vw,4rem)}
.section__h2{font-family:var(--ff);font-weight:700;font-size:clamp(2rem,4.5vw,4rem);letter-spacing:-.02em;line-height:1.05;margin-bottom:.6rem}
.section__sub{color:var(--muted);font-size:.95rem;max-width:44ch;line-height:1.65}

/* SERVICES */
.services__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem}
.svc{background:#fff;border:1px solid var(--border);border-radius:var(--r);padding:clamp(1.75rem,3vw,2.75rem);display:flex;flex-direction:column;gap:1.25rem;box-shadow:var(--shadow);transition:all .3s}
.svc:hover{box-shadow:var(--shadow-lg);transform:translateY(-3px);border-color:rgba(22,163,74,.2)}
.svc__num{font-family:var(--mono);font-size:.63rem;color:var(--accent);background:var(--accent-bg);display:inline-block;padding:.25rem .6rem;border-radius:99px}
.svc__title{font-family:var(--ff);font-weight:600;font-size:clamp(1.35rem,2vw,1.85rem);letter-spacing:-.01em;line-height:1.15}
.svc__desc{color:var(--muted);font-size:.88rem;line-height:1.65;flex:1}
.svc__link{font-size:.83rem;font-weight:600;color:var(--accent);display:flex;align-items:center;gap:.35rem;transition:gap .2s}
.svc:hover .svc__link{gap:.65rem}
@media(max-width:640px){.services__grid{grid-template-columns:1fr}}

/* PRICING */
.pricing__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;align-items:start}
.pcard{background:#fff;border:1.5px solid var(--border);border-radius:var(--r);padding:clamp(1.75rem,2.5vw,2.5rem);display:flex;flex-direction:column;gap:1.75rem;box-shadow:var(--shadow);transition:all .3s;position:relative}
.pcard:hover{box-shadow:var(--shadow-lg);transform:translateY(-2px)}
.pcard--feat{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent),var(--shadow-lg);transform:scale(1.025)}
.pcard--feat:hover{transform:scale(1.025) translateY(-2px)}
.pcard__badge{position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:var(--accent);color:#fff;font-family:var(--mono);font-size:.6rem;letter-spacing:.08em;text-transform:uppercase;padding:.3rem .9rem;border-radius:99px;white-space:nowrap}
.pcard__tier{font-family:var(--mono);font-size:.65rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.pcard__price{font-family:var(--ff);font-weight:700;font-size:clamp(2rem,3vw,2.75rem);letter-spacing:-.03em;line-height:1}
.pcard__price-suffix{font-family:var(--sans);font-size:.85rem;font-weight:400;color:var(--muted)}
.pcard__for{font-size:.82rem;color:var(--muted);margin-top:-.75rem}
.pcard__features{display:flex;flex-direction:column;gap:.6rem;flex:1}
.pcard__features li{font-size:.83rem;display:flex;align-items:flex-start;gap:.6rem;line-height:1.45;color:var(--muted)}
.pcard__features li::before{content:'✓';color:var(--accent);font-weight:700;flex-shrink:0;margin-top:.1rem}
@media(max-width:900px){.pricing__grid{grid-template-columns:1fr;max-width:440px}.pcard--feat{transform:none}}

/* DEMO */
.demo{background:var(--accent);color:#fff;padding:clamp(5rem,10vw,9rem) 0;position:relative;overflow:hidden}
.demo__inner{position:relative;z-index:1;max-width:800px}
.demo__h2{font-family:var(--ff);font-weight:700;font-style:normal;font-size:clamp(2.5rem,6vw,6rem);letter-spacing:-.03em;line-height:.98}
.demo__sub{font-size:clamp(1rem,1.5vw,1.2rem);margin-top:1.75rem;opacity:.82;max-width:46ch;line-height:1.65}
.demo__cta{margin-top:2.5rem;display:inline-flex;align-items:center;gap:.6rem;background:#fff;color:var(--accent);padding:1rem 2.25rem;font-weight:700;font-size:1rem;border-radius:99px;transition:all .2s;box-shadow:0 4px 20px rgba(0,0,0,.12)}
.demo__cta:hover{box-shadow:0 6px 30px rgba(0,0,0,.18);transform:translateY(-2px)}
.demo__bgblob{position:absolute;right:-8%;top:-20%;width:60%;height:140%;background:rgba(255,255,255,.07);border-radius:50%;pointer-events:none}

/* PROCESS */
.process__steps{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem}
.pstep{background:#fff;border:1px solid var(--border);border-radius:var(--r);padding:1.75rem;display:flex;flex-direction:column;gap:.85rem;box-shadow:var(--shadow);transition:all .3s}
.pstep:hover{box-shadow:var(--shadow-lg);transform:translateY(-3px)}
.pstep__num{width:2.5rem;height:2.5rem;background:var(--accent-bg);color:var(--accent);border-radius:10px;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:.72rem}
.pstep__title{font-family:var(--ff);font-weight:600;font-size:1.15rem;letter-spacing:-.01em}
.pstep__desc{font-size:.83rem;color:var(--muted);line-height:1.55}
@media(max-width:768px){.process__steps{grid-template-columns:repeat(2,1fr)}}

/* GUARANTEES */
.guar__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem}
.guar__card{background:#fff;border:1px solid var(--border);border-radius:var(--r);padding:1.75rem 2rem;display:flex;flex-direction:column;gap:.75rem;box-shadow:var(--shadow)}
.guar__ico{font-size:1.5rem;line-height:1}
.guar__title{font-family:var(--ff);font-weight:600;font-size:1.05rem;letter-spacing:-.01em}
.guar__desc{font-size:.83rem;color:var(--muted);line-height:1.6}
@media(max-width:768px){.guar__grid{grid-template-columns:1fr}}

/* FAQ */
details.faqitem{border-bottom:1px solid var(--border)}
details.faqitem:first-child{border-top:1px solid var(--border)}
summary.faqitem__q{display:flex;align-items:center;justify-content:space-between;padding:1.5rem 0;font-weight:600;font-size:clamp(.92rem,1.4vw,1.05rem);cursor:pointer;list-style:none;gap:1rem;transition:color .2s}
summary.faqitem__q::-webkit-details-marker{display:none}
summary.faqitem__q:hover{color:var(--accent)}
.faqitem__ico{flex-shrink:0;width:1.6rem;height:1.6rem;background:var(--bg2);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.9rem;color:var(--muted);transition:all .3s}
details[open] .faqitem__ico{background:var(--accent);color:#fff;transform:rotate(45deg)}
.faqitem__a{padding:0 0 1.5rem;color:var(--muted);font-size:.9rem;line-height:1.7;max-width:65ch}

/* FORM */
.formsec{background:var(--bg2);padding:clamp(5rem,10vw,9rem) 0}
.formwrap{max-width:720px;margin:0 auto}
.form__steplbl{display:flex;justify-content:space-between;margin-bottom:.65rem}
.form__prog{height:3px;background:rgba(28,25,23,.12);border-radius:99px;margin-bottom:3rem;overflow:hidden}
.form__progbar{height:100%;background:var(--accent);border-radius:99px;transition:width .4s cubic-bezier(.16,1,.3,1);width:25%}
.form__step{display:none}
.form__step.active{display:block;animation:fadeUp .4s cubic-bezier(.16,1,.3,1) both}
@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
.form__stitle{font-family:var(--ff);font-weight:700;font-size:clamp(1.5rem,3vw,2.25rem);letter-spacing:-.02em;margin-bottom:.4rem}
.form__ssub{color:var(--muted);font-size:.88rem;margin-bottom:2rem}
.rcards{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}
.rcard{position:relative}
.rcard input[type=radio]{position:absolute;opacity:0;width:0;height:0}
.rcard label{display:flex;flex-direction:column;gap:.3rem;padding:1.25rem 1.5rem;border:1.5px solid var(--border);border-radius:var(--r);cursor:pointer;transition:all .2s;background:#fff}
.rcard input:checked+label{border-color:var(--accent);background:var(--accent-bg)}
.rcard label:hover{border-color:var(--accent);box-shadow:var(--shadow)}
.rcard__title{font-weight:600;font-size:.93rem}
.rcard__desc{font-size:.78rem;color:var(--muted)}
.ffield{margin-bottom:1.25rem}
.ffield label{display:block;font-family:var(--mono);font-size:.63rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:.5rem}
.ffield input,.ffield select,.ffield textarea{width:100%;background:#fff;border:1.5px solid var(--border);color:var(--text);padding:.9rem 1rem;font-family:var(--sans);font-size:1rem;border-radius:10px;transition:border-color .2s,box-shadow .2s;outline:none;-webkit-appearance:none;appearance:none}
.ffield input:focus,.ffield select:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(22,163,74,.12)}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.fchk{display:flex;align-items:center;gap:.75rem;cursor:pointer;font-size:.88rem;margin-bottom:1rem}
.fchk input{display:none}
.fchk__box{width:1.25rem;height:1.25rem;border:1.5px solid var(--borderm);border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .2s;background:#fff}
.fchk input:checked~.fchk__box{background:var(--accent);border-color:var(--accent)}
.fchk input:checked~.fchk__box::after{content:'✓';font-size:.7rem;color:#fff;font-weight:700}
.form__nav{display:flex;align-items:center;justify-content:space-between;margin-top:2.5rem;gap:1rem}
.form__back{font-family:var(--mono);font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);cursor:pointer;transition:color .2s;padding:.5rem 0}
.form__back:hover{color:var(--text)}
.form__success{display:none;text-align:center;padding:3rem 0}
.form__success.show{display:block}
.form__success-ico{font-size:3rem;margin-bottom:1rem}
.form__success h3{font-family:var(--ff);font-weight:700;font-size:2rem;letter-spacing:-.02em;margin-bottom:.75rem}
.form__success p{color:var(--muted);font-size:.9rem}
@media(max-width:480px){.rcards{grid-template-columns:1fr}.frow{grid-template-columns:1fr}}

/* FOOTER */
.footer{border-top:1px solid var(--border);padding:4rem 0 2.5rem}
.footer__top{display:grid;grid-template-columns:2fr 1fr 1fr;gap:4rem;padding-bottom:3rem;border-bottom:1px solid var(--border);margin-bottom:2rem}
.footer__logo{font-family:var(--ff);font-weight:700;font-size:1.5rem;margin-bottom:.75rem}
.footer__logo span{color:var(--accent)}
.footer__tagline{font-size:.83rem;color:var(--muted);max-width:30ch;line-height:1.6}
.footer__coltitle{font-family:var(--mono);font-size:.63rem;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);margin-bottom:1.25rem}
.footer__links{display:flex;flex-direction:column;gap:.6rem}
.footer__links a{font-size:.88rem;color:var(--muted);transition:color .2s}
.footer__links a:hover{color:var(--text)}
.footer__bottom{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.footer__copy{font-family:var(--mono);font-size:.65rem;color:var(--muted2);letter-spacing:.05em}
@media(max-width:768px){.footer__top{grid-template-columns:1fr;gap:2rem}}

/* STICKY */
.sticky{display:none;position:fixed;bottom:0;left:0;right:0;z-index:50;padding:.75rem var(--pad);background:rgba(244,245,244,.96);backdrop-filter:blur(12px);border-top:1px solid var(--border)}
.sticky .btn{width:100%;justify-content:center}
@media(max-width:768px){.sticky{display:block}body{padding-bottom:5rem}}
</style>
{% endblock %}

{% block body %}

<nav class="nav" id="nav">
  <div class="wrap nav__inner">
    <a href="/warm" class="nav__logo">Jan Červinka<span>.</span></a>
    <ul class="nav__links">
      <li><a href="#sluzby">Služby</a></li>
      <li><a href="#cenik">Ceník</a></li>
      <li><a href="#o-mne">O mně</a></li>
      <li><a href="#faq">FAQ</a></li>
    </ul>
    <a href="#kontakt" class="btn btn--accent nav__cta">Nezávazná nabídka</a>
    <button class="nav__toggle" id="navToggle" aria-label="Menu"><span></span><span></span></button>
